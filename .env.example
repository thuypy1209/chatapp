# ========================================================
# FILE MẪU CẤU HÌNH MÔI TRƯỜNG (.ENV.EXAMPLE)
# Hãy đổi tên file này thành .env và điền thông tin thật của bạn
# ========================================================

PORT=3000
NODE_ENV=development

# Chuỗi kết nối MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.fl3sldi.mongodb.net/ChatApp?retryWrites=true&w=majority

# Khóa bí mật dùng để ký Token phiên
ADMIN_SECRET=your_random_64_character_secret_key_here

# Thông tin tài khoản Super Admin khởi tạo lần đầu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
