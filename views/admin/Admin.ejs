        <div class="admin-modal-box">
            <button type="button" class="admin-modal-close" onclick="closeChangeAdminPasswordModal()" title="Đóng (ESC)">✕</button>
            <div class="admin-modal-icon">
                🔑
            </div>
            <h3 class="admin-modal-title">Đổi mật khẩu tài khoản</h3>
            <p class="admin-modal-desc">
