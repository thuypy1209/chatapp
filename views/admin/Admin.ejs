    var titleInput = document.getElementById('brand-title-input');
    var previewIcon = document.getElementById('preview-brand-icon');
    var previewTitle = document.getElementById('preview-brand-title');
    var icon = iconInput ? iconInput.value.trim() : '';
    if (previewIcon) {
        if (icon) {
            previewIcon.textContent = icon;
            previewIcon.style.display = 'inline-block';
        } else {
            previewIcon.textContent = '';
            previewIcon.style.display = 'none';
        }
    }
    if (titleInput && previewTitle) {
        previewTitle.textContent = titleInput.value.trim() || 'Phổi bạn không phải tôi';
    }
}

function selectBrandIcon(icon) {
