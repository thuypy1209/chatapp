}

function toggleShowPassword(inputId, iconId) {
    var inp = document.getElementById(inputId);
    var icon = document.getElementById(iconId);
    if (!inp) return;
    if (inp.type === 'password') {
        inp.type = 'text';
        if (icon) icon.innerText = '🙈';
    } else {
        inp.type = 'password';
        if (icon) icon.innerText = '👁️';
    }
}

function submitChangeAdminPassword(e) {
    e.preventDefault();
    var adminId = document.getElementById('modal-cp-admin-id').value;
    var newPassword = document.getElementById('modal-cp-password').value.trim();
    var errEl = document.getElementById('modal-cp-error');

    if (!newPassword || newPassword.length < 6) {
        errEl.innerText = 'Mật khẩu mới phải có từ 6 ký tự trở lên!';
        errEl.style.display = 'block';
        return;
    }

    var submitBtn = document.getElementById('btn-modal-cp-submit');
    if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Đang lưu...';
    }

    fetch('/admin/api/accounts/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ adminId: adminId, newPassword: newPassword })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerText = '💾 Lưu mật khẩu';
        }
        if (data.success) {
            closeChangeAdminPasswordModal();
            showAdminAccountsAlert(data.message, true);
        } else {
            errEl.innerText = data.error || 'Lỗi đổi mật khẩu!';
            errEl.style.display = 'block';
        }
    })
    .catch(function(err) {
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerText = '💾 Lưu mật khẩu';
        }
        errEl.innerText = 'Lỗi kết nối máy chủ!';
        errEl.style.display = 'block';
    });
}

