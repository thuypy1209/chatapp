                    </div>
                    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                        <input type="file" id="edit-music-file-${idx}" accept="audio/*" style="font-size: 12px; padding: 6px 10px; border: 1px solid #fdba74; border-radius: 6px; background: #fff; cursor: pointer; flex: 1; min-width: 200px;">
