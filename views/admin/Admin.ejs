                                        <span style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #047857; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 700;">
                                            <%= u.lastPage || 'Phòng Chat' %>
                                        </span>
                                    </td>
                                    <td style="padding: 10px 14px; text-align: center; font-weight: 700; color: #db2777;">
                                        <%= u.visitCount || 1 %>
