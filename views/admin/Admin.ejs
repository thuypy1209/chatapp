    </div>


</div>

<style>
.badge-icon-btn {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 6px;
    font-size: 14px;
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.1s ease, background 0.15s ease;
}
.badge-icon-btn:hover {
    transform: scale(1.2);
    background: #dcfce7;
    border-color: #4ade80;
}
</style>

<script>
// ===== QUẢN LÝ NHẠC NỀN TOÀN HỆ THỐNG - TRANG ADMIN =====

// Hàm chọn nhanh icon cho Badge nhãn
function selectBadgeIcon(inputId, icon) {
    var el = document.getElementById(inputId);
    if (!el) return;
    var val = el.value.trim();
    // Tách bỏ emoji có sẵn ở đầu chuỗi (kèm theo khoảng trắng nếu có)
    var textOnly = val.replace(/^[\p{Extended_Pictographic}\u200d\ufe0f\u2600-\u27bf\u{1f300}-\u{1f9ff}]+\s*/u, '').trim();
    if (textOnly) {
        el.value = icon + ' ' + textOnly;
    } else {
        el.value = icon + ' ';
    }
    el.focus();
}

// Hàm trích xuất ID YouTube chuẩn (hỗ trợ link đầy đủ, link rút gọn, shorts, hoặc ID 11 ký tự)
function extractYouTubeId(urlOrId) {
    if (!urlOrId) return '';
    var str = urlOrId.trim();
    if (/^[a-zA-Z0-9_-]{11}$/.test(str)) return str;
    var match = str.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))([\w-]{11})/i);
    return match ? match[1] : '';
}

// Danh sách phiên bản nhạc NCT DREAM - "Graduation" (Đã kiểm tra 100% hoạt động)
var DEFAULT_ADMIN_MUSIC_VERSIONS = [
    { id: "4EteI8yAsv0", title: "Graduation (Relaxing Piano)", artist: "Catiano Cover • Không bản quyền", badge: "🎹 Relaxing Piano", speed: 1.0, audioUrl: "/audio/bgm.mp3" },
    { id: "zuoSn3ObMz4", title: "Graduation (Special Video MV)", artist: "NCT DREAM • SM Entertainment", badge: "🎵 Bản MV", speed: 1.0, audioUrl: "/audio/graduation-nct-dream.mp3" },
    { id: "eF2qrRYiRuM", title: "Graduation (Piano Acoustic)", artist: "Piano Cover • Không bản quyền", badge: "🛡️ Piano Cover", speed: 0.9, audioUrl: "/audio/bgm.mp3" },
    { id: "EznbdoHi0Zs", title: "Graduation (Official Audio)", artist: "NCT DREAM • SM Entertainment", badge: "⭐ Official", speed: 1.0, audioUrl: "/audio/graduation-nct-dream.mp3" }
];

// Upload file âm thanh riêng cho từng bài hát lên /admin/music-track-upload
async function uploadTrackAudioFile(file) {
    var formData = new FormData();
    formData.append('trackAudio', file);
    var res = await fetch('/admin/music-track-upload', {
        method: 'POST',
        body: formData
    });
    var data = await res.json();
    if (!data.success) {
        throw new Error(data.error || 'Lỗi tải lên file âm thanh!');
    }
    return data.audioUrl;
}

// Nghe thử file MP3 trực tiếp trong Admin
var currentPlayingTrackAudio = null;
var currentPlayingTrackBtn = null;
function toggleTrackAudioPreview(url, btn) {
    if (!url) {
        showAdminToast('⚠️ Bài hát này chưa có file MP3 đính kèm!', 'warning');
        return;
    }
    if (currentPlayingTrackAudio && !currentPlayingTrackAudio.paused) {
        currentPlayingTrackAudio.pause();
        if (currentPlayingTrackBtn) currentPlayingTrackBtn.innerHTML = '▶ Nghe thử MP3';
        if (currentPlayingTrackBtn === btn) {
            currentPlayingTrackAudio = null;
            currentPlayingTrackBtn = null;
            return;
        }
    }
    currentPlayingTrackAudio = new Audio(url);
    currentPlayingTrackBtn = btn;
    btn.innerHTML = '⏸ Đang phát...';
    currentPlayingTrackAudio.play().then(function() {
        showAdminToast('▶ Đang phát file MP3...', 'info');
    }).catch(function(e) {
        console.error('Không thể phát file mp3:', e);
        btn.innerHTML = '▶ Nghe thử MP3';
        showAdminToast('❌ Không thể phát file MP3 này (Lỗi: ' + (e.message || 'File không tìm thấy') + ')', 'error');
    });
    currentPlayingTrackAudio.onended = function() {
        btn.innerHTML = '▶ Nghe thử MP3';
        currentPlayingTrackAudio = null;
        currentPlayingTrackBtn = null;
    };
}

// Gỡ file MP3 khỏi bài hát
function removeTrackMP3(idx) {
    if (!ADMIN_MUSIC_VERSIONS[idx]) return;
    if (confirm('Bạn có chắc muốn gỡ bỏ file MP3 đính kèm khỏi bài hát "' + ADMIN_MUSIC_VERSIONS[idx].title + '"?')) {
        ADMIN_MUSIC_VERSIONS[idx].audioUrl = null;
        syncMusicVersionsToServer();
        renderMusicVersionsList();
        showAdminToast('✓ Đã gỡ file MP3 khỏi bài hát!', 'info');
    }
}

var ADMIN_MUSIC_VERSIONS = DEFAULT_ADMIN_MUSIC_VERSIONS;
try {
    var stored = JSON.parse(localStorage.getItem('chatflex_music_versions'));
    if (Array.isArray(stored) && stored.length > 0 && !stored.some(v => v.id === "R234wY4tTes" || v.id === "wcrkltAbh_g")) {
        ADMIN_MUSIC_VERSIONS = stored;
    } else {
        localStorage.setItem('chatflex_music_versions', JSON.stringify(DEFAULT_ADMIN_MUSIC_VERSIONS));
    }
} catch (e) {
    ADMIN_MUSIC_VERSIONS = DEFAULT_ADMIN_MUSIC_VERSIONS;
}

var currentMusicSetting = { versionIndex: 0, speed: 1.0, customAudioUrl: null };
var editingTrackIndex = null; // Quản lý index của bài đang mở chỉnh sửa

// Đồng bộ danh sách bài hát lên máy chủ MongoDB và localStorage
function syncMusicVersionsToServer(callback) {
    localStorage.setItem('chatflex_music_versions', JSON.stringify(ADMIN_MUSIC_VERSIONS));
    fetch('/admin/music-versions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ versions: ADMIN_MUSIC_VERSIONS })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success && typeof callback === 'function') {
            callback();
        }
    })
    .catch(err => console.error('Lỗi lưu danh sách bài hát lên server:', err));
}

// Lấy cài đặt hiện tại từ server
function loadCurrentMusicSetting() {
    fetch('/api/music-setting')
        .then(r => r.json())
        .then(data => {
            currentMusicSetting = data;
            if (Array.isArray(data.versions) && data.versions.length > 0) {
                ADMIN_MUSIC_VERSIONS = data.versions;
                localStorage.setItem('chatflex_music_versions', JSON.stringify(ADMIN_MUSIC_VERSIONS));
            }
            renderMusicVersionsList();
            updateNowPlayingLabel();
            if (data.customAudioUrl) {
                var revertBtn = document.getElementById('btn-revert-youtube');
                if (revertBtn) revertBtn.style.display = 'inline-flex';
            }
        })
        .catch(() => {});
}

// Cập nhật nhãn "đang phát"
function updateNowPlayingLabel() {
    var label = document.getElementById('music-now-playing-label');
    var speedLabel = document.getElementById('music-now-speed-label');
    if (!label) return;

    if (currentMusicSetting.customAudioUrl) {
        label.textContent = '📁 ' + (currentMusicSetting.customFileName || 'File MP3 tùy chỉnh');
    } else {
        var ver = ADMIN_MUSIC_VERSIONS[currentMusicSetting.versionIndex];
        label.textContent = ver ? (ver.badge + ' ' + ver.title) : 'Không xác định';
    }
    if (speedLabel) {
        speedLabel.textContent = 'Tốc độ: ' + (currentMusicSetting.speed || 1.0) + 'x';
    }
}

// Render toàn bộ danh sách phiên bản nhạc (Có chế độ Xem & Sửa)
function renderMusicVersionsList() {
    var container = document.getElementById('music-versions-list');
    if (!container) return;
    container.innerHTML = '';

    ADMIN_MUSIC_VERSIONS.forEach(function(ver, idx) {
        var isActive = !currentMusicSetting.customAudioUrl && currentMusicSetting.versionIndex === idx;
        var trackSpeed = (typeof ver.speed === 'number') ? ver.speed : 1.0;
        var isEditing = (editingTrackIndex === idx);

        var card = document.createElement('div');

        // CHẾ ĐỘ 1: ĐANG CHỈNH SỬA BÀI HÁT NÀY
        if (isEditing) {
            card.style.cssText = 'background:#fff7ed; border:2px solid #fb923c; border-radius:14px; padding:16px; box-shadow:0 6px 18px rgba(251,146,60,0.18); margin-bottom:4px;';
            card.innerHTML = `
                <div style="font-size:14px; font-weight:800; color:#c2410c; margin-bottom:12px; display:flex; align-items:center; gap:6px;">
                    <span>✏️</span> Chỉnh sửa thông tin bài hát #${idx + 1}
                </div>

                <div style="display:grid; grid-template-columns: 1.1fr 1.3fr; gap:12px; margin-bottom:12px;">
                    <div>
                        <label style="font-size:12px; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Tên bài hát (*):</label>
                        <input type="text" id="edit-title-${idx}" value="${ver.title.replace(/"/g, '&quot;')}" style="width:100%; padding:8px 12px; border:1.5px solid #fdba74; border-radius:8px; font-size:13px; font-weight:600; outline:none; background:#fff;">
                    </div>
                    <div>
                        <label style="font-size:12px; font-weight:700; color:#334155; display:block; margin-bottom:4px;">🔗 Link URL YouTube (*):</label>
                        <input type="text" id="edit-url-${idx}" value="https://www.youtube.com/watch?v=${ver.id}" placeholder="https://www.youtube.com/watch?v=... hoặc https://youtu.be/..." style="width:100%; padding:8px 12px; border:1.5px solid #fdba74; border-radius:8px; font-size:13px; outline:none; background:#fff;">
                    </div>
                </div>

                <div style="display:grid; grid-template-columns: 1.2fr 1fr 0.8fr; gap:12px; margin-bottom:10px;">
                    <div>
                        <label style="font-size:12px; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Tên nghệ sĩ / Nguồn:</label>
                        <input type="text" id="edit-artist-${idx}" value="${(ver.artist || '').replace(/"/g, '&quot;')}" style="width:100%; padding:8px 12px; border:1.5px solid #fdba74; border-radius:8px; font-size:13px; outline:none; background:#fff;">
                    </div>
                    <div>
                        <label style="font-size:12px; font-weight:700; color:#334155; display:block; margin-bottom:4px;">Badge nhãn:</label>
                        <input type="text" id="edit-badge-${idx}" value="${(ver.badge || '').replace(/"/g, '&quot;')}" placeholder="VD: ⭐ Official" style="width:100%; padding:8px 12px; border:1.5px solid #fdba74; border-radius:8px; font-size:13px; outline:none; background:#fff;">
                    </div>
                    <div>
                        <label style="font-size:12px; font-weight:700; color:#334155; display:block; margin-bottom:4px;">⚡ Tốc độ phát:</label>
