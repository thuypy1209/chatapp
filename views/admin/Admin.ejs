            <!-- Render bằng JS -->
        </div>

        <!-- Form thêm phiên bản YouTube mới -->
        <div style="background: #f0fdf4; border: 1.5px dashed #86efac; border-radius: 14px; padding: 16px; margin-bottom: 20px;">
