                    </thead>
                    <tbody id="chat-users-table-body">
                        <% if (typeof chatUsers !== 'undefined' && chatUsers && chatUsers.length > 0) { %>
                            <% chatUsers.forEach(function(u, idx) { %>
                                <tr style="border-bottom: 1px solid #f1f5f9;" id="chat-user-row-<%= u._id %>" class="chat-user-row" data-username="<%= (u.username || '').toLowerCase() %>">
                                    <td style="padding: 10px 14px; color: #94a3b8; font-weight: 700; width: 45px;">
                                        #<%= idx + 1 %>
                                    </td>
                                    <td style="padding: 10px 14px; font-weight: 700; color: #1e293b;">
                                        <div style="display: flex; align-items: center; gap: 8px;">
