function openChangeAdminPasswordModal(adminId, username) {
    if ((username || '').toLowerCase() === 'admin') {
        alert('Tài khoản gốc "admin" (Super Administrator) được hệ thống bảo vệ cố định, không được phép đổi mật khẩu hay xóa!');
