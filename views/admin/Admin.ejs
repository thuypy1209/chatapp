function resetBrandSettingToDefault() {
    var iconInput = document.getElementById('brand-icon-input');
    var titleInput = document.getElementById('brand-title-input');
    var welcomeInput = document.getElementById('brand-welcome-input');
    if (iconInput) iconInput.value = '🍄';
    if (titleInput) titleInput.value = 'Phổi bạn không phải tôi';
    if (welcomeInput) welcomeInput.value = 'Chào mừng bạn đến Phổi bạn không phải tôi!';
    updateBrandLivePreview();
    showAdminToast('✓ Đã điền thông tin mặc định, nhấn "Lưu thay đổi" để áp dụng!', 'info');
}

function handleSaveBrandSetting(e) {
    if (e && e.preventDefault) e.preventDefault();
    var iconInput = document.getElementById('brand-icon-input');
    var icon = iconInput ? iconInput.value.trim() : '';
    var title = document.getElementById('brand-title-input').value.trim() || 'Phổi bạn không phải tôi';
    var welcome = document.getElementById('brand-welcome-input').value.trim() || ('Chào mừng bạn đến ' + title + '!');

    var btn = document.getElementById('btn-save-brand-setting');
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '⏳ Đang lưu...';
    }

    fetch('/admin/api/brand-setting', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ brandIcon: icon, brandTitle: title, welcomeText: welcome })
    })
    .then(r => r.json())
    .then(data => {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '💾 Lưu thay đổi tiêu đề';
        }
        if (data.success) {
            // Cập nhật ngay thanh Navbar của trang Admin hiện tại
            var navBrand = document.querySelector('.navbar-brand');
            var navBrandIcon = document.querySelector('.navbar-brand .brand-icon');
            var navBrandText = document.querySelector('.navbar-brand .brand-text');

            if (icon) {
                if (!navBrandIcon && navBrand) {
                    navBrandIcon = document.createElement('span');
                    navBrandIcon.className = 'brand-icon';
                    navBrand.insertBefore(navBrandIcon, navBrandText);
                }
                if (navBrandIcon) {
                    navBrandIcon.textContent = icon;
                    navBrandIcon.style.display = 'inline-block';
                }
            } else if (navBrandIcon) {
                navBrandIcon.style.display = 'none';
                navBrandIcon.textContent = '';
            }

            if (navBrandText) navBrandText.textContent = title;
            document.title = title;
            showAdminToast('✓ Đã cập nhật tiêu đề thương hiệu thành công: ' + (icon ? (icon + ' ') : '') + title, 'success');
        } else {
            showAdminToast('❌ ' + (data.error || 'Lỗi khi lưu tiêu đề!'), 'error');
        }
    })
    .catch(err => {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '💾 Lưu thay đổi tiêu đề';
        }
        showAdminToast('❌ Lỗi kết nối máy chủ!', 'error');
    });
}

</script>

