                style="background: #fdf2f8; border: 1.5px solid #fbcfe8; color: #db2777; padding: 5px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px; pointer-events: none; transition: all 0.2s ease;">
                <span>Thu gọn</span> <span class="arrow-icon" style="font-size: 10px;">▲</span>
