                    </button>
                </div>
            </div>

            <!-- Bảng danh sách người dùng -->
            <div style="overflow-x: auto; background: #ffffff; border-radius: 12px; border: 1px solid #fbcfe8;">
                <table style="width: 100%; border-collapse: collapse; font-size: 13px; text-align: left;">
                    <thead>
                        <tr style="background: #fdf2f8; border-bottom: 2px solid #fbcfe8; color: #831843;">
                            <th style="padding: 10px 14px;">STT</th>
                            <th style="padding: 10px 14px;">Tên Người dùng</th>
                            <th style="padding: 10px 14px;">Lần đầu tham gia</th>
                            <th style="padding: 10px 14px;">Hoạt động gần nhất</th>
                            <th style="padding: 10px 14px;">Trang truy cập</th>
                            <th style="padding: 10px 14px; text-align: center;">Số lần</th>
                            <th style="padding: 10px 14px; text-align: right;">Hành động</th>
