            <!-- Thanh tìm kiếm & công cụ -->
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
                <div style="position: relative; flex: 1; max-width: 380px; min-width: 240px;">
                    <input type="text" id="search-chat-users-input" placeholder="🔍 Tìm kiếm theo tên người dùng..." oninput="handleSearchChatUsers(this.value)"
                        style="width: 100%; padding: 9px 14px 9px 36px; border: 1.5px solid #cbd5e1; border-radius: 10px; font-size: 13px; outline: none; transition: border-color 0.2s;"
                        onfocus="this.style.borderColor='#db2777'" onblur="this.style.borderColor='#cbd5e1'">
                    <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-size: 14px; color: #94a3b8; pointer-events: none;">👤</span>
                </div>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <button type="button" onclick="refreshChatUsersList()" style="background: #f1f5f9; border: 1px solid #cbd5e1; color: #334155; padding: 8px 14px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px;">
