// ===== QUẢN LÝ NGƯỜI DÙNG ĐÃ VÀO NHẮN TIN TRÒ CHUYỆN (CHAT USERS) =====
function handleSearchChatUsers(keyword) {
    var kw = (keyword || '').toLowerCase().trim();
    var rows = document.querySelectorAll('.chat-user-row');
    var visibleCount = 0;
    rows.forEach(function(row) {
        var user = row.getAttribute('data-username') || '';
        if (!kw || user.includes(kw)) {
            row.style.display = '';
            visibleCount++;
        } else {
            row.style.display = 'none';
        }
    });
    var emptyRow = document.getElementById('chat-users-empty-row');
    if (emptyRow) {
        emptyRow.style.display = (visibleCount === 0 && rows.length > 0) ? '' : 'none';
    }
}

function refreshChatUsersList() {
    var tbody = document.getElementById('chat-users-table-body');
    var badge = document.getElementById('chat-users-badge-count');
    if (!tbody) return;

    fetch('/admin/api/chat-users')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success && data.users) {
                if (badge) badge.innerText = data.users.length + ' người dùng';
                if (data.users.length === 0) {
                    tbody.innerHTML = '<tr id="chat-users-empty-row"><td colspan="7" style="padding: 24px; text-align: center; color: #64748b;">Chưa có người dùng nào nhập tên vào trò chuyện.</td></tr>';
                    return;
                }
                var html = '';
                data.users.forEach(function(u, idx) {
                    var formatVN = function(d) {
                        if (!d) return '';
                        try {
                            return new Date(d).toLocaleString('vi-VN', {
                                timeZone: 'Asia/Ho_Chi_Minh',
                                hour: '2-digit', minute: '2-digit', second: '2-digit',
                                day: '2-digit', month: '2-digit', year: 'numeric',
                                hour12: false
                            });
                        } catch(e) { return ''; }
                    };
                    var created = u.createdAt ? formatVN(u.createdAt) : 'Không rõ';
                    var active = u.lastActive ? formatVN(u.lastActive) : (u.createdAt ? formatVN(u.createdAt) : 'Mới tham gia');
                    var page = u.lastPage || 'Phòng Chat';
                    var visits = u.visitCount || 1;
                    var cleanName = (u.username || '').replace(/'/g, "\\'");
                    html += '<tr style="border-bottom: 1px solid #f1f5f9;" id="chat-user-row-' + u._id + '" class="chat-user-row" data-username="' + (u.username || '').toLowerCase() + '">' +
                        '<td style="padding: 10px 14px; color: #94a3b8; font-weight: 700; width: 45px;">#' + (idx + 1) + '</td>' +
                        '<td style="padding: 10px 14px; font-weight: 700; color: #1e293b;">' +
                            '<div style="display: flex; align-items: center; gap: 8px;">' +
                                '<span class="chat-user-avatar" data-name="' + cleanName + '" style="width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(135deg, #fdf2f8 0%, #fce7f3 100%); border: 1.5px solid #fbcfe8; display: inline-flex; align-items: center; justify-content: center; font-size: 16px; box-shadow: 0 1px 4px rgba(219,39,119,0.1);">' + (window.getEmojiForName ? window.getEmojiForName(u.username) : '🐱') + '</span>' +
                                '<span style="font-size: 14px;">' + u.username + '</span>' +
                            '</div>' +
                        '</td>' +
                        '<td style="padding: 10px 14px; color: #475569; font-size: 12px;">' + created + '</td>' +
                        '<td style="padding: 10px 14px; color: #059669; font-weight: 600; font-size: 12px;">' + active + '</td>' +
                        '<td style="padding: 10px 14px;"><span style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #047857; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 700;">' + page + '</span></td>' +
                        '<td style="padding: 10px 14px; text-align: center; font-weight: 700; color: #db2777;">' + visits + '</td>' +
                        '<td style="padding: 10px 14px; text-align: right;">' +
                            (currentIsSuperAdmin ? 
                                '<button type="button" onclick="openDeleteChatUserModal(\'' + u._id + '\', \'' + cleanName + '\')" style="background: #fee2e2; border: 1px solid #fca5a5; color: #dc2626; padding: 5px 12px; border-radius: 6px; font-size: 12px; cursor: pointer; font-weight: 700; transition: all 0.15s ease;" title="Xóa người dùng này để giải phóng tên">🗑️ Xóa</button>' :
                                '<span class="admin-badge-viewonly" title="Chỉ Super Admin mới có quyền xóa người dùng">👁️ Chỉ xem</span>'
                            ) +
                        '</td>' +
                    '</tr>';
                });
                tbody.innerHTML = html;
            }
        })
        .catch(function(err) {
            console.error('Lỗi refresh chat users:', err);
        });
}

var currentIsSuperAdmin = <%= (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) ? 'true' : 'false' %>;

function openDeleteChatUserModal(userId, username) {
    if (!currentIsSuperAdmin) {
        alert('Chỉ Super Admin mới có quyền xóa người dùng khỏi hệ thống!');
        return;
    }
    var modal = document.getElementById('modal-delete-chat-user');
    if (!modal) {
        if (confirm('Bạn có chắc chắn muốn xóa người dùng "' + username + '" khỏi hệ thống không?\n* Tên này sẽ được giải phóng để người khác có thể sử dụng lại.')) {
            executeDeleteChatUser(userId);
        }
        return;
    }
    document.getElementById('modal-del-chat-userid').value = userId;
    document.getElementById('modal-del-chat-username').innerText = '"' + username + '"';
    var errEl = document.getElementById('modal-del-chat-error');
    if (errEl) errEl.style.display = 'none';
    modal.style.display = 'flex';
}

function closeDeleteChatUserModal() {
    var modal = document.getElementById('modal-delete-chat-user');
    if (modal) modal.style.display = 'none';
}

function confirmDeleteChatUser() {
    var userId = document.getElementById('modal-del-chat-userid').value;
    if (!userId) return;
    executeDeleteChatUser(userId);
}

function executeDeleteChatUser(userId) {
    var errEl = document.getElementById('modal-del-chat-error');
    var submitBtn = document.getElementById('btn-modal-del-chat-submit');

    if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Đang xóa...';
    }

    fetch('/admin/api/chat-users/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: userId })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerText = '🗑️ Xóa vĩnh viễn';
        }
        if (data.success) {
            closeDeleteChatUserModal();
            var row = document.getElementById('chat-user-row-' + userId);
            if (row) row.remove();
            var alertEl = document.getElementById('chat-users-alert');
            if (alertEl) {
                alertEl.innerText = data.message;
                alertEl.style.display = 'block';
                alertEl.style.background = '#dcfce7';
                alertEl.style.border = '1px solid #86efac';
                alertEl.style.color = '#166534';
                setTimeout(function() { alertEl.style.display = 'none'; }, 4000);
            }
            var remaining = document.querySelectorAll('.chat-user-row').length;
            var countEl = document.getElementById('chat-users-badge-count');
            if (countEl) countEl.innerText = remaining + ' người dùng';
            if (remaining === 0) {
                var tbody = document.getElementById('chat-users-table-body');
                if (tbody) {
                    tbody.innerHTML = '<tr id="chat-users-empty-row"><td colspan="7" style="padding: 24px; text-align: center; color: #64748b;">Chưa có người dùng nào nhập tên vào trò chuyện.</td></tr>';
                }
            }
        } else {
            if (errEl) {
                errEl.innerText = data.error || 'Lỗi xóa người dùng!';
                errEl.style.display = 'block';
            } else {
                alert(data.error || 'Lỗi xóa người dùng!');
            }
        }
    })
    .catch(function(err) {
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerText = '🗑️ Xóa vĩnh viễn';
        }
        if (errEl) {
            errEl.innerText = 'Lỗi kết nối máy chủ!';
            errEl.style.display = 'block';
        } else {
            alert('Lỗi kết nối máy chủ!');
        }
    });
}

function handleDeleteChatUser(userId, username) {
    openDeleteChatUserModal(userId, username);
}

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeDeleteChatUserModal();
    }
});


