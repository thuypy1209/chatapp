<%- include('../partials/header') %>

<div class="main-container" style="max-width: 1050px; margin: 25px auto 40px auto; padding: 0 15px; position: relative; z-index: 5;">

    <!-- Tiêu đề trang quản trị -->
    <div style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); padding: 18px 24px; border-radius: 18px; border: 2px solid #fbcfe8; box-shadow: 0 4px 16px rgba(244, 114, 182, 0.12); margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 32px; line-height: 1;">⚙️</span>
            <div>
                <h1 style="font-size: 22px; margin: 0; color: #1e293b; font-weight: 800;">Quản lý Nhân vật & Kịch bản</h1>
                <p style="font-size: 13px; margin: 0; color: #64748b;">Thêm mới nhân vật, kịch bản hội thoại (.txt), ảnh đại diện và âm thanh tương tác.</p>
            </div>
        </div>
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            <div style="background: #ffffff; border: 1.5px solid #fbcfe8; padding: 6px 14px; border-radius: 20px; font-size: 13px; color: #334155; display: flex; align-items: center; gap: 8px; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
                <span>👤</span>
                <span style="font-weight: 700; color: #1e293b;"><%= (typeof currentAdmin !== 'undefined' && currentAdmin) ? currentAdmin : 'Admin' %></span>
                <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
                    <span style="background: #fef08a; border: 1px solid #facc15; color: #854d0e; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 800;">⭐ Super Admin</span>
                <% } else { %>
                    <span style="background: #eff6ff; border: 1px solid #bfdbfe; color: #1d4ed8; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 700;">Admin</span>
                <% } %>
            </div>
            <div style="background: #fdf2f8; padding: 6px 14px; border-radius: 20px; border: 1px solid #fbcfe8; font-size: 13px; font-weight: 700; color: #db2777;">
                Tổng số: <%= (typeof characters !== 'undefined' && characters) ? characters.length : 0 %> nhân vật
            </div>
        </div>
    </div>

    <!-- KHỐI 1: FORM THÊM NHÂN VẬT & KỊCH BẢN MỚI -->
    <div class="admin-card" id="section-character-add" style="background: rgba(255, 255, 255, 0.97); backdrop-filter: blur(10px); border-radius: 20px; border: 2px solid #fbcfe8; box-shadow: 0 8px 24px rgba(0,0,0,0.06); padding: 22px 24px; margin-bottom: 24px; transition: all 0.2s ease;">
        <div onclick="toggleAdminSection('character-form-body', 'character-toggle-btn')" 
             style="display: flex; justify-content: space-between; align-items: center; cursor: pointer; user-select: none;"
             title="Bấm để thu gọn hoặc mở rộng phần này">
            <h2 style="font-size: 17px; margin: 0; color: #db2777; font-weight: 800; display: flex; align-items: center; gap: 8px;">
                <span>✨</span> Thêm nhân vật, File kịch bản (.txt) & Media đính kèm
            </h2>
            <button type="button" id="character-toggle-btn"
                style="background: #fdf2f8; border: 1.5px solid #fbcfe8; color: #db2777; padding: 5px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px; pointer-events: none; transition: all 0.2s ease;">
                <span>Thu gọn</span> <span class="arrow-icon" style="font-size: 10px;">▲</span>
            </button>
        </div>

        <div id="character-form-body" style="margin-top: 18px; border-top: 2px dashed #fbcfe8; padding-top: 18px;">
        <form action="/admin/character/add-full" method="POST" enctype="multipart/form-data">
            
            <!-- Phần 1: Tên & Mô tả nhân vật -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; margin-bottom: 20px;">
                
                <!-- Tên nhân vật -->
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 6px;">
                        Tên nhân vật (*):
                    </label>
                    <input type="text" name="name" class="form-control" placeholder="VD: Bác sĩ tư vấn, Super Mario..." required
                        style="width: 100%; padding: 10px 14px; border: 2px solid #e2e8f0; border-radius: 10px; font-size: 14px; outline: none; transition: border-color 0.2s;"
                        onfocus="this.style.borderColor='#db2777'" onblur="this.style.borderColor='#e2e8f0'">
                </div>

                <!-- Mô tả ngắn -->
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 6px;">
                        Mô tả ngắn:
                    </label>
                    <input type="text" name="description" class="form-control" placeholder="VD: Hỗ trợ giải đáp sức khỏe, tư vấn khách hàng..."
                        style="width: 100%; padding: 10px 14px; border: 2px solid #e2e8f0; border-radius: 10px; font-size: 14px; outline: none; transition: border-color 0.2s;"
                        onfocus="this.style.borderColor='#db2777'" onblur="this.style.borderColor='#e2e8f0'">
                </div>

            </div>

            <!-- Phần 2: Icon Custom & KHU VỰC AVATAR STUDIO -->
            <div class="admin-studio-grid" style="display: grid; grid-template-columns: 1fr 1.35fr; gap: 20px; background: #fdfbf7; padding: 20px; border-radius: 16px; border: 1px solid #fbcfe8; margin-bottom: 22px;">
                
                <!-- CỘT 1: TÙY CHỌN ICON ĐẠI DIỆN TIN NHẮN (CUSTOM) -->
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 700; color: #db2777; margin-bottom: 8px;">
                        🎨 Icon đại diện tin nhắn (Custom Emoji):
                    </label>
                    
                    <div style="display: flex; gap: 12px; align-items: center; margin-bottom: 12px;">
                        <!-- Khung hiển thị to của Icon được chọn -->
                        <div id="icon-display-large" style="width: 54px; height: 54px; border-radius: 14px; background: #ffffff; border: 2px solid #f472b6; box-shadow: 0 3px 0 #db2777; display: flex; align-items: center; justify-content: center; font-size: 28px; flex-shrink: 0;">
                            🎮
                        </div>

                        <!-- Ô nhập trực tiếp icon tùy biến -->
                        <div style="flex: 1;">
                            <input type="text" id="iconInput" name="icon" value="🎮" placeholder="Gõ emoji bất kỳ..."
                                style="width: 100%; padding: 8px 12px; font-size: 18px; border: 2px solid #fbcfe8; border-radius: 8px; outline: none; background: #fff;"
                                onfocus="this.style.borderColor='#db2777'" onblur="this.style.borderColor='#fbcfe8'">
                            <span style="font-size: 11px; color: #64748b; margin-top: 3px; display: block;">* Gõ hoặc dán emoji tùy ý</span>
                        </div>
                    </div>

                    <!-- Bảng Icon Gợi ý Nhanh -->
                    <div class="common-icon-picker" style="display: flex; gap: 6px; background: #ffffff; padding: 10px; border: 1px dashed #f59e0b; border-radius: 10px; flex-wrap: wrap;">
                        <% const commonIcons = ['🎮', '🍄', '⭐', '💻', '🧳', '🌿', '🍳', '⚔️', '⛏️', '🧙‍♂️', '🐱', '🌸', '💎', '📜', '🤖', '👑', '🔮', '🧸', '⚡', '🔥']; %>
                        <% commonIcons.forEach(function(iconEmoji) { %>
                            <button type="button" onclick="selectCommonIcon('<%= iconEmoji %>')" 
                                    style="font-size: 18px; cursor: pointer; background: #fdf2f8; border: 1px solid #fbcfe8; border-radius: 6px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; transition: transform 0.1s ease;"
                                    onmouseover="this.style.transform='scale(1.2)';"
                                    onmouseout="this.style.transform='scale(1)';">
                                <%= iconEmoji %>
                            </button>
                        <% }); %>
                    </div>
                </div>

                <!-- CỘT 2: AVATAR STUDIO CHUYÊN NGHIỆP -->
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 700; color: #db2777; margin-bottom: 8px;">
                        🖼️ Ảnh đại diện (Avatar Studio - Xem trước & Tải ảnh):
                    </label>

                    <div style="background: #ffffff; padding: 16px; border-radius: 14px; border: 2px solid #fbcfe8; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
                        <div style="display: flex; gap: 16px; align-items: center;">
                            
                            <!-- VÒNG TRÒN PREVIEW AVATAR LỚN (CLICK-TO-UPLOAD & DRAG-DROP) -->
                            <div id="avatar-circle-preview" title="Bấm vào đây để chọn ảnh hoặc kéo thả ảnh vào" 
                                style="width: 88px; height: 88px; border-radius: 50%; border: 3px solid #f472b6; box-shadow: 0 4px 14px rgba(244, 114, 182, 0.25); background: #fdf2f8; position: relative; overflow: hidden; cursor: pointer; flex-shrink: 0; display: flex; align-items: center; justify-content: center; transition: all 0.2s ease;">
                                
                                <!-- Ảnh preview khi có chọn file -->
                                <img id="avatar-preview-img" src="" alt="Avatar" style="display: none; width: 100%; height: 100%; object-fit: cover;">
                                
                                <!-- Icon placeholder khi chưa có ảnh -->
                                <div id="avatar-placeholder-icon" style="font-size: 38px; user-select: none;">
                                    🎮
                                </div>

                                <!-- Overlay camera khi rê chuột -->
                                <div class="avatar-hover-overlay" style="position: absolute; inset: 0; background: rgba(0,0,0,0.45); color: #fff; font-size: 11px; font-weight: 700; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.2s;"
                                    onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0'">
                                    <span style="font-size: 18px;">📷</span>
                                    <span>Chọn ảnh</span>
                                </div>
                            </div>

                            <!-- CÁC THAO TÁC AVATAR -->
                            <div style="flex: 1; min-width: 0;">
                                <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 6px;">
                                    <button type="button" onclick="document.getElementById('avatar-input').click()" 
                                        style="background: #fdf2f8; color: #db2777; border: 1.5px solid #fbcfe8; padding: 7px 14px; border-radius: 8px; font-weight: 700; font-size: 12px; cursor: pointer; display: flex; align-items: center; gap: 6px; box-shadow: 0 2px 0 #f472b6;">
                                        <span>📁</span> Chọn ảnh từ máy tính
                                    </button>
                                    
                                    <button type="button" id="btn-remove-avatar" style="display: none; background: #fee2e2; color: #dc2626; border: 1.5px solid #fca5a5; padding: 7px 12px; border-radius: 8px; font-weight: 600; font-size: 12px; cursor: pointer;">
                                        ✕ Gỡ ảnh
                                    </button>
                                </div>

                                <!-- Thẻ input file ẩn (kích hoạt bằng click) -->
                                <input type="file" id="avatar-input" name="avatar" accept="image/*" style="display: none;">
                                <input type="hidden" id="avatar-url-input" name="avatarUrl" value="">

                                <!-- Trạng thái ảnh -->
                                <div id="avatar-info-text" style="font-size: 12px; color: #64748b; margin-bottom: 8px;">
                                    Bấm vào vòng tròn hoặc kéo thả file ảnh vào
                                </div>

                                <!-- Ô dán URL ảnh trực tuyến -->
                                <div style="display: flex; gap: 6px; align-items: center;">
                                    <input type="text" id="avatar-url-field" placeholder="Hoặc dán link ảnh online (https://...)" 
                                        style="width: 100%; padding: 6px 10px; font-size: 11px; border: 1px solid #cbd5e1; border-radius: 6px; outline: none; background: #f8fafc;"
                                        onfocus="this.style.borderColor='#db2777'" onblur="this.style.borderColor='#cbd5e1'">
                                </div>
                            </div>

                        </div>

                        <!-- BỘ AVATAR MẪU CÓ SẴN (PRESET AVATARS 1 CHẠM) -->
                        <div style="margin-top: 12px; padding-top: 10px; border-top: 1px dashed #fbcfe8;">
                            <div style="font-size: 11px; font-weight: 700; color: #db2777; margin-bottom: 6px;">
                                ⭐ Hoặc chọn nhanh Avatar mẫu chất lượng cao:
                            </div>
                            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                                <button type="button" onclick="selectPresetAvatar('https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/poke-ball.png', 'Pokeball Retro')"
                                    style="display: flex; align-items: center; gap: 4px; padding: 4px 8px; border-radius: 8px; background: #fdf2f8; border: 1px solid #fbcfe8; cursor: pointer; font-size: 11px; font-weight: 600; color: #db2777;">
                                    <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/poke-ball.png" style="width: 20px; height: 20px;"> Pokeball
                                </button>

                                <button type="button" onclick="selectPresetAvatar('https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/super-potion.png', 'Bình năng lượng')"
                                    style="display: flex; align-items: center; gap: 4px; padding: 4px 8px; border-radius: 8px; background: #fdf2f8; border: 1px solid #fbcfe8; cursor: pointer; font-size: 11px; font-weight: 600; color: #db2777;">
                                    <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/super-potion.png" style="width: 20px; height: 20px;"> Bình thuốc
                                </button>

                                <button type="button" onclick="selectPresetAvatar('https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/master-ball.png', 'Masterball')"
                                    style="display: flex; align-items: center; gap: 4px; padding: 4px 8px; border-radius: 8px; background: #fdf2f8; border: 1px solid #fbcfe8; cursor: pointer; font-size: 11px; font-weight: 600; color: #db2777;">
                                    <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/master-ball.png" style="width: 20px; height: 20px;"> Master Ball
                                </button>

                                <button type="button" onclick="selectPresetAvatar('https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/rare-candy.png', 'Kẹo may mắn')"
                                    style="display: flex; align-items: center; gap: 4px; padding: 4px 8px; border-radius: 8px; background: #fdf2f8; border: 1px solid #fbcfe8; cursor: pointer; font-size: 11px; font-weight: 600; color: #db2777;">
                                    <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/rare-candy.png" style="width: 20px; height: 20px;"> Kẹo sao
                                </button>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

            <!-- Phần 3: File Kịch bản .txt (CÓ XEM TRƯỚC TRỰC QUAN & HƯỚNG DẪN MẪU) -->
            <div style="background: #ffffff; padding: 18px; border-radius: 14px; border: 2px solid #fbcfe8; margin-bottom: 22px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 8px;">
                    <label style="font-size: 14px; font-weight: 700; color: #db2777; display: flex; align-items: center; gap: 6px;">
                        <span>📜</span> Tải lên file kịch bản hội thoại (.txt) (*):
                    </label>
                    <button type="button" onclick="var el = document.getElementById('script-guide-box'); el.style.display = (el.style.display==='none'?'block':'none');"
                        style="background: #fdf2f8; border: 1px solid #fbcfe8; color: #db2777; padding: 4px 10px; border-radius: 8px; font-size: 12px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 4px;">
                        💡 Xem hướng dẫn & Tải file mẫu .txt
                    </button>
                </div>

                <!-- HỘP HƯỚNG DẪN CHI TIẾT CÁCH VIẾT KỊCH BẢN .TXT -->
                <div id="script-guide-box" style="display: none; background: #fdfbf7; border: 1.5px dashed #f59e0b; border-radius: 12px; padding: 16px; margin-bottom: 14px;">
                    <div style="font-size: 13px; font-weight: 800; color: #b45309; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                        <span>📖</span> Quy tắc viết file kịch bản .txt chuẩn:
                    </div>
                    <ul style="font-size: 12px; color: #475569; margin: 0 0 10px 18px; line-height: 1.6;">
                        <li><b>Dòng bắt đầu bằng <code>Q: </code>:</b> Là các nút câu hỏi / lựa chọn của người dùng (có thể có nhiều <code>Q:</code> trong 1 khối).</li>
                        <li><b>Dòng bắt đầu bằng <code>A: </code>:</b> Là câu bot sẽ trả lời khi người dùng bấm vào các câu hỏi <code>Q:</code> đó.</li>
                        <li><b>Dấu <code>---</code>:</b> Ngăn cách giữa các bước (khối hội thoại). Khi bot trả lời khối 1, các <code>Q:</code> của khối 2 sẽ xuất hiện tiếp theo!</li>
                    </ul>

                    <!-- Mẫu kịch bản có thể sao chép nhanh -->
                    <div style="background: #1e293b; color: #f8fafc; padding: 12px; border-radius: 8px; font-family: monospace; font-size: 11px; line-height: 1.5; margin-bottom: 10px; position: relative;">
                        Q: Xin chào, bạn là ai?<br>
                        Q: Giới thiệu về bạn đi!<br>
                        A: Chào bạn! Mình là trợ lý ảo sẵn sàng đồng hành cùng bạn!<br>
                        ---<br>
                        Q: Bạn có thể giúp gì cho tôi?<br>
                        Q: Bắt đầu cuộc trò chuyện như thế nào?<br>
                        A: Bạn có thể chọn bất kỳ câu hỏi nào để chúng ta cùng khám phá nhé!
                    </div>

                    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                        <a href="/uploads/seeds/mau_kich_ban_chuan.txt" download="mau_kich_ban_chuan.txt" 
                            style="background: #fef08a; border: 1px solid #facc15; color: #854d0e; text-decoration: none; padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">
                            📥 Tải file kịch bản mẫu (.txt)
                        </a>
                        <a href="/uploads/seeds/mau_kich_ban_mario.txt" download="mau_kich_ban_mario.txt" 
                            style="background: #fdf2f8; border: 1px solid #fbcfe8; color: #db2777; text-decoration: none; padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">
                            📥 Tải kịch bản Super Mario (.txt)
                        </a>
                    </div>
                </div>

                <input type="file" id="script-input" name="scriptFile" accept=".txt" required
                    style="width: 100%; padding: 10px 14px; border: 2px dashed #f472b6; border-radius: 10px; background: #fdf2f8; cursor: pointer; font-size: 13px;">

                <!-- KHUNG XEM TRƯỚC KỊCH BẢN (SCRIPT PREVIEW) -->
                <div id="script-preview-wrapper" style="display: none; margin-top: 15px; border-top: 1px dashed #fbcfe8; padding-top: 14px;">
                    
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 12px;">
                        <div id="script-preview-stats" style="font-size: 13px; color: #1e293b; display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
                        </div>
                        <button type="button" id="btn-toggle-raw-script" style="background: #f1f5f9; border: 1px solid #cbd5e1; color: #475569; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;">
                            📝 Xem mã text gốc
                        </button>
                    </div>

                    <div id="script-preview-content" style="max-height: 250px; overflow-y: auto; background: #fdfbf7; border: 1px solid #fbcfe8; border-radius: 10px; padding: 14px;">
                    </div>

                    <textarea id="script-raw-content" readonly style="display: none; width: 100%; height: 200px; font-family: monospace; font-size: 12px; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; background: #f8fafc; color: #334155; resize: vertical;"></textarea>
                </div>
            </div>

            <!-- Phần 4: Đính kèm Media & Âm thanh -->
            <div style="background: #ffffff; padding: 18px; border-radius: 14px; border: 2px solid #e2e8f0; margin-bottom: 22px;">
                <h3 style="font-size: 15px; margin: 0 0 14px 0; color: #1e293b; font-weight: 700; display: flex; align-items: center; gap: 6px;">
                    <span>🎵</span> Đính kèm Media & Âm thanh mở đầu
                </h3>

                <div id="dialogue-container">
                    <div class="node-box" id="node-0" style="background: #fdfbf7; border: 1px solid #fbcfe8; padding: 14px; border-radius: 12px; margin-bottom: 12px;">
                        <div style="font-size: 13px; font-weight: 700; color: #db2777; margin-bottom: 8px;">
                            Âm thanh chào mừng (Bước 1):
                        </div>
                        
                        <input type="file" id="audio-input" name="nodeAudio_0" accept="audio/*"
                            style="width: 100%; padding: 8px 12px; border: 2px dashed #cbd5e1; border-radius: 8px; background: #fff; cursor: pointer; font-size: 13px;">

                        <div id="audio-preview-wrapper" style="display: none; margin-top: 10px; background: #ffffff; padding: 10px 14px; border-radius: 10px; border: 1px solid #e2e8f0;">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                <span style="font-size: 12px; font-weight: 700; color: #15803d; display: flex; align-items: center; gap: 4px;">
                                    <span>▶️</span> Nghe thử file âm thanh đã chọn:
                                </span>
                                <span id="audio-file-name" style="font-size: 12px; color: #64748b;"></span>
                                <button type="button" id="btn-remove-audio" style="background: none; border: none; color: #ef4444; font-size: 12px; cursor: pointer; font-weight: 600;">
                                    ✕ Gỡ âm thanh
                                </button>
                            </div>
                            <audio id="audio-preview-player" controls style="width: 100%; height: 36px;"></audio>
                        </div>
                    </div>
                </div>

                <button type="button" id="btn-add-node" style="background: #f1f5f9; border: 2px dashed #cbd5e1; color: #475569; padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; width: 100%;">
