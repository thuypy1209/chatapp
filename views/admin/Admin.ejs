        </div>
    </div>

    <!-- KHỐI 2: QUẢN LÝ NHẠC NỀN -->
    <div id="music-management" class="admin-card" style="scroll-margin-top: 85px; background: rgba(255,255,255,0.97); backdrop-filter: blur(10px); border-radius: 20px; border: 2px solid #fdba74; box-shadow: 0 8px 24px rgba(251,146,60,0.1); padding: 22px 24px; margin-bottom: 24px; transition: all 0.2s ease;">
        <div onclick="toggleAdminSection('music-management-body', 'music-toggle-btn')" 
             style="display: flex; justify-content: space-between; align-items: center; cursor: pointer; user-select: none;"
             title="Bấm để thu gọn hoặc mở rộng phần này">
