                    <span style="font-size: 11px; font-weight: 700; color: #c2410c; white-space: nowrap; margin-right: 2px;">🎨 Gợi ý icon:</span>
                    ${['⭐', '🎵', '🎹', '🎧', '🎸', '🌸', '🛡️', '⚡', '🔥', '💎', '✨', '☕', '🌌'].map(ic => `
                        <button type="button" onclick="selectBadgeIcon('edit-badge-${idx}', '${ic}')" style="background:#fff7ed; border:1px solid #fed7aa; border-radius:6px; font-size:13px; width:26px; height:26px; display:inline-flex; align-items:center; justify-content:center; cursor:pointer; transition:transform 0.1s;" onmouseover="this.style.transform='scale(1.2)';" onmouseout="this.style.transform='scale(1)';">${ic}</button>
