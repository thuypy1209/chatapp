            card.innerHTML = `
                <div style="flex:1; min-width:220px;">
                    <div style="font-size:13px; font-weight:700; color:#1e293b; display:flex; align-items:center; gap:6px;">
                        <span>${ver.badge || '🎵'}</span> <span>${ver.title}</span>
                        ${isActive ? '<span style="background:#dcfce7;color:#166534;font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;border:1px solid #86efac;">▶ Đang phát</span>' : ''}
                    </div>
                    <div style="font-size:11px; color:#64748b; margin-top:3px; display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                        <span>🐷 ${ver.artist || 'Chưa có tác giả'}</span>
                        <span>•</span>
                        <a href="https://www.youtube.com/watch?v=${ver.id}" target="_blank" style="color:#2563eb; text-decoration:none; display:inline-flex; align-items:center; gap:3px;" title="Mở video YouTube trên tab mới">
                            🔗 youtu.be/${ver.id}
                        </a>
                        ${ver.audioUrl ? `
                            <span>•</span>
                            <span style="background:#ecfdf5; color:#047857; border:1px solid #a7f3d0; padding:1px 6px; border-radius:6px; font-size:10px; font-weight:700; display:inline-flex; align-items:center; gap:3px;">
                                📁 MP3
                            </span>
                            <button type="button" onclick="toggleTrackAudioPreview('${ver.audioUrl}', this)" style="background:none; border:none; color:#16a34a; font-size:11px; font-weight:700; cursor:pointer; padding:0; display:inline-flex; align-items:center; gap:2px;" title="Bấm để nghe thử file MP3">
                                ▶ Nghe thử MP3
                            </button>
                        ` : ''}
