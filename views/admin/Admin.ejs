                <div style="display:flex; justify-content:flex-end; gap:8px;">
                    <button type="button" onclick="cancelEditTrack()" style="background:#f1f5f9; color:#475569; border:1px solid #cbd5e1; padding:7px 16px; border-radius:8px; font-size:12px; font-weight:700; cursor:pointer;">✕ Hủy</button>
                    <button type="button" onclick="saveEditTrack(${idx})" style="background:#22c55e; color:#fff; border:none; padding:7px 20px; border-radius:8px; font-size:12px; font-weight:800; cursor:pointer; box-shadow:0 2px 8px rgba(34,197,94,0.3);">💾 Lưu thay đổi</button>
