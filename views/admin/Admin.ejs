                </div>

                <!-- Tùy chọn tốc độ riêng của từng bài -->
                <div style="display:flex; align-items:center; gap:5px; background:${isActive ? '#dcfce7' : '#f8fafc'}; padding:4px 8px; border-radius:8px; border:1px solid ${isActive ? '#86efac' : '#e2e8f0'};" title="Đổi tốc độ phát cho bài này">
                    <span style="font-size:11px; font-weight:700; color:#475569;">⚡ Tốc độ:</span>
                    <select onchange="changeTrackSpeed(${idx}, parseFloat(this.value))" style="
                        padding: 3px 6px;
                        border: 1px solid #fdba74;
                        border-radius: 6px;
                        font-size: 11px;
                        font-weight: 700;
                        background: #fff;
                        color: #c2410c;
                        cursor: pointer;
                        outline: none;
                    ">
                        <option value="0.85" ${trackSpeed === 0.85 ? 'selected' : ''}>0.85x</option>
                        <option value="0.9" ${trackSpeed === 0.9 ? 'selected' : ''}>0.9x</option>
                        <option value="1.0" ${trackSpeed === 1.0 ? 'selected' : ''}>1.0x</option>
                        <option value="1.05" ${trackSpeed === 1.05 ? 'selected' : ''}>1.05x</option>
                        <option value="1.15" ${trackSpeed === 1.15 ? 'selected' : ''}>1.15x</option>
                        <option value="1.25" ${trackSpeed === 1.25 ? 'selected' : ''}>1.25x</option>
                    </select>
                </div>

                <!-- Nút thao tác: Phát, Sửa, Xóa -->
                <div style="display:flex; align-items:center; gap:6px; flex-shrink:0;">
                    ${!isActive ? `<button type="button" onclick="switchMusicVersion(${idx})" style="background:#fdf2f8;color:#db2777;border:1px solid #fbcfe8;padding:6px 14px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;">▶ Phát ngay</button>` : ''}
                    <button type="button" onclick="startEditTrack(${idx})" style="background:#eff6ff;color:#2563eb;border:1px solid #bfdbfe;padding:6px 12px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;" title="Chỉnh sửa tên, link URL và tốc độ của bài này">✏️ Sửa</button>
                    ${ADMIN_MUSIC_VERSIONS.length > 1 && !isActive ? `<button type="button" onclick="deleteMusicVersion(${idx})" style="background:#fee2e2;color:#dc2626;border:1px solid #fca5a5;padding:6px 10px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;" title="Xóa bài này">🗑️ Xóa</button>` : ''}
                </div>
            `;
        }

        container.appendChild(card);
    });
}

// Mở giao diện chỉnh sửa một bài hát
function startEditTrack(idx) {
    editingTrackIndex = idx;
    renderMusicVersionsList();
}

// Hủy chỉnh sửa
function cancelEditTrack() {
    editingTrackIndex = null;
    renderMusicVersionsList();
}

// Lưu thông tin sau khi chỉnh sửa bài hát
async function saveEditTrack(idx) {
    var titleEl = document.getElementById('edit-title-' + idx);
    var urlEl = document.getElementById('edit-url-' + idx);
    var artistEl = document.getElementById('edit-artist-' + idx);
    var badgeEl = document.getElementById('edit-badge-' + idx);
    var speedEl = document.getElementById('edit-speed-' + idx);
    var fileInput = document.getElementById('edit-music-file-' + idx);

    if (!titleEl || !urlEl) return;
    var title = titleEl.value.trim();
    var rawUrl = urlEl.value.trim();
    var artist = artistEl ? artistEl.value.trim() : '';
    var badge = badgeEl ? badgeEl.value.trim() : '';
    var speed = speedEl ? parseFloat(speedEl.value) : 1.0;

    if (!title) {
        showAdminToast('⚠️ Vui lòng nhập tiêu đề bài hát!', 'warning');
        return;
    }
    var ytid = extractYouTubeId(rawUrl);
    if (!ytid) {
        showAdminToast('⚠️ Link URL YouTube không hợp lệ! Vui lòng dán link YouTube đầy đủ hoặc ID 11 ký tự', 'warning');
        return;
    }

    var existingAudioUrl = ADMIN_MUSIC_VERSIONS[idx] ? ADMIN_MUSIC_VERSIONS[idx].audioUrl : null;
    var finalAudioUrl = existingAudioUrl;

    if (fileInput && fileInput.files && fileInput.files[0]) {
        try {
            showAdminToast('⏳ Đang tải file MP3 mới lên server...', 'info');
            finalAudioUrl = await uploadTrackAudioFile(fileInput.files[0]);
        } catch (err) {
            showAdminToast('❌ ' + (err.message || 'Lỗi tải lên file MP3!'), 'error');
            return;
        }
    }

    ADMIN_MUSIC_VERSIONS[idx] = {
        id: ytid,
        title: title,
        artist: artist || 'Không rõ nguồn',
        badge: badge || '🎵 Tùy chỉnh',
        speed: speed || 1.0,
        audioUrl: finalAudioUrl || null
    };

    editingTrackIndex = null;
    syncMusicVersionsToServer();
    renderMusicVersionsList();

    // Nếu bài vừa sửa đang phát thì cập nhật ngay lập tức cho toàn web
    var isActive = !currentMusicSetting.customAudioUrl && currentMusicSetting.versionIndex === idx;
    if (isActive) {
        fetch('/admin/music-setting', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ versionIndex: idx, speed: speed })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                currentMusicSetting = data.setting;
                updateNowPlayingLabel();
            }
        });
    }

    showAdminToast('✓ Đã cập nhật thành công bài hát: ' + title + (fileInput && fileInput.files && fileInput.files[0] ? ' (kèm file MP3 mới)' : ''), 'success');
}

// Thay đổi tốc độ nhanh của từng bài hát
function changeTrackSpeed(idx, newSpeed) {
    if (!ADMIN_MUSIC_VERSIONS[idx]) return;
    ADMIN_MUSIC_VERSIONS[idx].speed = newSpeed;
    syncMusicVersionsToServer();

    var isActive = !currentMusicSetting.customAudioUrl && currentMusicSetting.versionIndex === idx;
    if (isActive) {
        fetch('/admin/music-setting', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ versionIndex: idx, speed: newSpeed })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                currentMusicSetting = data.setting;
                updateNowPlayingLabel();
                showAdminToast('✓ Đã cập nhật tốc độ ' + newSpeed + 'x cho toàn web!', 'success');
            }
        });
    } else {
        showAdminToast('✓ Đã lưu tốc độ ' + newSpeed + 'x cho bài "' + ADMIN_MUSIC_VERSIONS[idx].title + '"', 'info');
    }
}

// Chuyển sang phiên bản nhạc
function switchMusicVersion(idx) {
    var speed = (ADMIN_MUSIC_VERSIONS[idx] && typeof ADMIN_MUSIC_VERSIONS[idx].speed === 'number') ? ADMIN_MUSIC_VERSIONS[idx].speed : 1.0;
    fetch('/admin/music-setting', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ versionIndex: idx, speed: speed })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            currentMusicSetting = data.setting;
            renderMusicVersionsList();
            updateNowPlayingLabel();
            showAdminToast('✓ Đã chuyển sang: ' + ADMIN_MUSIC_VERSIONS[idx].title + ' (' + speed + 'x)', 'success');
        }
    });
}

// Thêm phiên bản YouTube mới bằng Link URL (Kèm tải file MP3 tùy chọn)
async function addMusicVersion() {
    var title = document.getElementById('new-music-title').value.trim();
    var rawUrl = document.getElementById('new-music-url').value.trim();
    var artist = document.getElementById('new-music-artist').value.trim();
    var badge  = document.getElementById('new-music-badge').value.trim();
    var speedEl = document.getElementById('new-music-speed');
    var speed = speedEl ? parseFloat(speedEl.value) : 1.0;
    var fileInput = document.getElementById('new-music-audio-file');

    if (!title || !rawUrl) {
        showAdminToast('⚠️ Vui lòng nhập Tiêu đề và Link URL YouTube!', 'warning');
        return;
    }

    var ytid = extractYouTubeId(rawUrl);
    if (!ytid) {
        showAdminToast('⚠️ Link URL YouTube không hợp lệ! Vui lòng dán link YouTube đầy đủ (VD: https://www.youtube.com/watch?v=...)', 'warning');
        return;
    }

    var audioUrl = null;
    if (fileInput && fileInput.files && fileInput.files[0]) {
        try {
            showAdminToast('⏳ Đang tải file MP3 bài hát lên server...', 'info');
            audioUrl = await uploadTrackAudioFile(fileInput.files[0]);
        } catch (err) {
            showAdminToast('❌ ' + (err.message || 'Lỗi tải lên file MP3!'), 'error');
            return;
        }
    }

    ADMIN_MUSIC_VERSIONS.push({
        id: ytid,
        title: title,
        artist: artist || 'Không rõ nguồn',
        badge: badge || '🎵 Tùy chỉnh',
        speed: speed || 1.0,
        audioUrl: audioUrl || null
    });

    syncMusicVersionsToServer();

    // Xóa form sau khi thêm
    document.getElementById('new-music-title').value = '';
    document.getElementById('new-music-url').value = '';
    document.getElementById('new-music-artist').value = '';
    document.getElementById('new-music-badge').value = '';
    if (fileInput) fileInput.value = '';

    renderMusicVersionsList();
    showAdminToast('✓ Đã thêm bài hát mới: ' + title + (audioUrl ? ' (kèm file MP3)' : ''), 'success');
}

// Xóa bài hát khỏi danh sách
function deleteMusicVersion(idx) {
    if (!confirm('Bạn chắc chắn muốn xóa bài "' + ADMIN_MUSIC_VERSIONS[idx].title + '"?')) return;
    ADMIN_MUSIC_VERSIONS.splice(idx, 1);
    syncMusicVersionsToServer();
    if (currentMusicSetting.versionIndex >= ADMIN_MUSIC_VERSIONS.length) {
        switchMusicVersion(0);
        return;
    }
    renderMusicVersionsList();
    showAdminToast('🗑️ Đã xóa bài hát khỏi danh sách', 'info');
}

// Upload MP3
function uploadAdminMP3() {
    var fileInput = document.getElementById('admin-mp3-upload');
    var statusEl = document.getElementById('mp3-upload-status');
    if (!fileInput.files[0]) {
        showAdminToast('⚠️ Vui lòng chọn file MP3 trước!', 'warning');
        return;
    }
    statusEl.style.display = 'block';
    statusEl.style.color = '#64748b';
    statusEl.textContent = '⏳ Đang tải file lên server...';

    var formData = new FormData();
    formData.append('musicFile', fileInput.files[0]);

    fetch('/admin/music-upload', { method: 'POST', body: formData })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                statusEl.style.color = '#15803d';
                statusEl.textContent = '✓ Đã tải lên và phát cho toàn website: ' + fileInput.files[0].name;
                currentMusicSetting = data.setting || currentMusicSetting;
                currentMusicSetting.customAudioUrl = data.audioUrl;
                document.getElementById('btn-revert-youtube').style.display = 'inline-flex';
                updateNowPlayingLabel();
                renderMusicVersionsList();
                showAdminToast('✓ Đang phát file MP3 cho toàn website!', 'success');
            } else {
                statusEl.style.color = '#dc2626';
                statusEl.textContent = '✗ Lỗi: ' + (data.error || 'Không thể tải lên');
            }
        })
        .catch(() => {
            statusEl.style.color = '#dc2626';
            statusEl.textContent = '✗ Lỗi kết nối, thử lại!';
        });
}

// Trở về YouTube
function revertToYoutube() {
    fetch('/admin/music-setting', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ versionIndex: currentMusicSetting.versionIndex || 0, speed: currentMusicSetting.speed || 1.0 })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            currentMusicSetting = data.setting;
            document.getElementById('btn-revert-youtube').style.display = 'none';
            document.getElementById('mp3-upload-status').style.display = 'none';
            document.getElementById('admin-mp3-upload').value = '';
            updateNowPlayingLabel();
            renderMusicVersionsList();
            showAdminToast('↩ Đã trở về phát YouTube!', 'info');
        }
    });
}

// Toast thông báo nhỏ
function showAdminToast(msg, type) {
    var colors = { success: '#dcfce7', warning: '#fef9c3', info: '#e0f2fe', error: '#fee2e2' };
    var textColors = { success: '#166534', warning: '#854d0e', info: '#0369a1', error: '#dc2626' };
    var toast = document.createElement('div');
    toast.textContent = msg;
    toast.style.cssText = 'position:fixed; bottom:80px; right:20px; background:' + (colors[type]||'#fff') + '; color:' + (textColors[type]||'#1e293b') + '; border-radius:10px; padding:10px 16px; font-size:13px; font-weight:700; box-shadow:0 4px 16px rgba(0,0,0,0.12); z-index:9999; animation:fadeIn 0.2s ease;';
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
}

// Cuộn tới section nhạc nếu URL có #music-management
if (window.location.hash === '#music-management') {
    setTimeout(() => {
        var musicBody = document.getElementById('music-management-body');
        if (musicBody && musicBody.style.display === 'none') {
            toggleAdminSection('music-management-body', 'music-toggle-btn');
        }
        var el = document.getElementById('music-management');
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 300);
}

// ===== THU GỌN / MỞ RỘNG CÁC SECTION TRANG ADMIN =====
function toggleAdminSection(bodyId, btnId) {
    var body = document.getElementById(bodyId);
    var btn = document.getElementById(btnId);
    if (!body || !btn) return;

    var textSpan = btn.querySelector('span');
    var arrowSpan = btn.querySelector('.arrow-icon');
    var isExpanded = (body.style.display !== 'none');

    if (isExpanded) {
        body.style.display = 'none';
        if (textSpan) textSpan.textContent = 'Mở rộng';
        if (arrowSpan) arrowSpan.textContent = '▼';
        btn.style.background = '#f1f5f9';
        btn.style.borderColor = '#cbd5e1';
        btn.style.color = '#64748b';
        localStorage.setItem('admin_section_' + bodyId, 'collapsed');
    } else {
        body.style.display = 'block';
        if (textSpan) textSpan.textContent = 'Thu gọn';
        if (arrowSpan) arrowSpan.textContent = '▲';
        if (btnId === 'character-toggle-btn') {
            btn.style.background = '#fdf2f8';
            btn.style.borderColor = '#fbcfe8';
            btn.style.color = '#db2777';
        } else {
            btn.style.background = '#fff7ed';
            btn.style.borderColor = '#fdba74';
            btn.style.color = '#c2410c';
        }
        localStorage.setItem('admin_section_' + bodyId, 'expanded');
    }
}

// Khôi phục trạng thái thu gọn đã lưu (nếu có)
function initCollapsibleSections() {
    var isMusicHash = (window.location.hash === '#music-management');
    var sections = [
        { bodyId: 'character-form-body', btnId: 'character-toggle-btn' },
        { bodyId: 'music-management-body', btnId: 'music-toggle-btn' }
    ];

    sections.forEach(function(s) {
        var savedState = localStorage.getItem('admin_section_' + s.bodyId);
        // Nếu người dùng vào thẳng link #music-management, luôn giữ khối nhạc MỞ RỘNG
        if (s.bodyId === 'music-management-body' && isMusicHash) {
            var body = document.getElementById(s.bodyId);
            var btn = document.getElementById(s.btnId);
            if (body) body.style.display = 'block';
            if (btn) {
                var textSpan = btn.querySelector('span');
                var arrowSpan = btn.querySelector('.arrow-icon');
                if (textSpan) textSpan.textContent = 'Thu gọn';
                if (arrowSpan) arrowSpan.textContent = '▲';
                btn.style.background = '#fff7ed';
                btn.style.borderColor = '#fdba74';
                btn.style.color = '#c2410c';
            }
            return;
        }

        if (savedState === 'collapsed') {
            toggleAdminSection(s.bodyId, s.btnId);
        }
    });

    if (isMusicHash) {
        setTimeout(function() {
            var target = document.getElementById('music-management');
            if (target) {
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }, 150);
    }
}

// Bắt sự kiện chuyển hash khi click từ widget
window.addEventListener('hashchange', function() {
    if (window.location.hash === '#music-management') {
        var body = document.getElementById('music-management-body');
        if (body && body.style.display === 'none') {
            toggleAdminSection('music-management-body', 'music-toggle-btn');
        }
        var target = document.getElementById('music-management');
        if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }
});

