<%- include('../partials/header') %>

<div class="main-container admin-login-wrapper">
    
    <div class="admin-card admin-login-card">
        
        <div class="admin-login-icon">
            🔒
        </div>

        <h1 class="admin-login-title">Xác thực Quản trị viên</h1>
        <p class="admin-login-desc">
            Trang này chỉ dành cho quản trị viên hệ thống. Vui lòng nhập mật khẩu tài khoản <b>Admin</b> để tiếp tục.
        </p>

        <div id="login-error-alert" class="welcome-error-alert"></div>

        <form id="admin-login-form" onsubmit="handleAdminLogin(event)">
            <div class="admin-login-group">
                <label class="admin-login-label">Tên tài khoản Admin (*):</label>
                <input type="text" id="admin-username-input" class="admin-login-input" value="<%= typeof adminUsername !== 'undefined' ? adminUsername : 'admin' %>" placeholder="Nhập tên tài khoản (VD: admin, huymn...)" required>
            </div>

            <div class="admin-login-group admin-login-group-last">
                <label class="admin-login-label">Mật khẩu Admin (*):</label>
                <input type="password" id="admin-password-input" class="admin-login-input" placeholder="Nhập mật khẩu quản trị..." required autofocus>
            </div>

            <button type="submit" id="btn-admin-submit" class="btn-admin-submit">
                🔑 Xác nhận & Vào trang Quản trị
            </button>
        </form>

        <div class="admin-login-back">
            <a href="/">← Quay về Trang chủ</a>
        </div>

    </div>

</div>

<script>
function handleAdminLogin(e) {
    e.preventDefault();
    var password = document.getElementById('admin-password-input').value.trim();
    var errorDiv = document.getElementById('login-error-alert');
    var btn = document.getElementById('btn-admin-submit');

    if (!password) {
        errorDiv.innerText = 'Vui lòng nhập mật khẩu!';
        errorDiv.style.display = 'block';
        return;
    }

    btn.innerText = 'Đang kiểm tra...';
    btn.disabled = true;

    var adminUserInput = document.getElementById('admin-username-input');
    var targetUsername = adminUserInput ? adminUserInput.value.trim() : 'Admin';

    fetch('/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username: targetUsername, password: password })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
        if (data.success && data.isAdmin) {
            window.location.href = window.location.hash ? ('/admin' + window.location.hash) : '/admin';
        } else {
            btn.innerText = '🔑 Xác nhận & Vào trang Quản trị';
            btn.disabled = false;
            errorDiv.innerText = data.error || 'Mật khẩu không chính xác!';
            errorDiv.style.display = 'block';
        }
    })
    .catch(function(err) {
        btn.innerText = '🔑 Xác nhận & Vào trang Quản trị';
        btn.disabled = false;
        errorDiv.innerText = 'Lỗi kết nối máy chủ, vui lòng thử lại!';
        errorDiv.style.display = 'block';
    });
}
</script>

<%- include('../partials/footer') %>
