<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Phổi bạn không phải tôi' %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <span class="brand-icon">🍄</span>
            <span class="brand-text">Phổi bạn không phải tôi</span>
        </a>
        <ul class="navbar-nav">
            <li><a href="/" class="nav-item">🏠 Trang chủ</a></li>
            <li><a href="/chat" class="nav-item">💬 Phòng Chat</a></li>
            <li><a href="/mario" class="nav-item nav-mario">🎮 Mario & Chat</a></li>
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <li><a href="/admin" class="nav-item nav-admin">⚙️ Quản trị</a></li>
            <% } %>

            <!-- Thông tin người dùng / Nút đổi tên -->
            <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                <li>
                    <div style="display: flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.45); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1.5px solid rgba(255, 255, 255, 0.65); padding: 5px 12px; border-radius: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
                        <span style="font-size: 13px; font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: 4px;">
                            <%= (typeof isAdmin !== 'undefined' && isAdmin) ? '⭐' : '👤' %> 
                            <span id="nav-username-display"><%= currentUser %></span>
                        </span>
                        <a href="/auth/logout" title="Đổi tên / Đăng xuất" style="background: rgba(254, 226, 226, 0.7); color: #dc2626; border-radius: 50%; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; font-size: 11px; text-decoration: none; font-weight: bold; border: 1px solid rgba(248, 113, 113, 0.35);">
                            ✕
                        </a>
                    </div>
                </li>
            <% } else { %>
                <li>
                    <button type="button" onclick="openWelcomeNameModal()" style="background: rgba(255, 255, 255, 0.45); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1.5px solid rgba(255, 255, 255, 0.65); color: #831843; padding: 7px 14px; border-radius: 12px; font-weight: 700; font-size: 13px; cursor: pointer; display: flex; align-items: center; gap: 4px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
                        👋 Nhập tên bạn
                    </button>
                </li>
            <% } %>
        </ul>
    </nav>
    <div class="cloud-retro cloud-1"></div>
    <div class="cloud-retro cloud-2"></div>
    <div class="cloud-retro cloud-3"></div>
    <div class="starry-sky"></div>
    <div class="mario-ground"></div>

    <!-- MODAL BẮT BUỘC NHẬP TÊN KHI VÀO TRANG -->
    <div id="welcome-name-modal" style="display: none; position: fixed; inset: 0; z-index: 9999; background: rgba(15, 23, 42, 0.78); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); align-items: center; justify-content: center; padding: 15px;">
        
        <div class="welcome-box" style="background: #ffffff; border-radius: 24px; border: 3px solid #f472b6; box-shadow: 0 12px 40px rgba(0,0,0,0.3); width: 100%; max-width: 440px; padding: 32px 28px; text-align: center; position: relative;">
            
            <div style="width: 72px; height: 72px; border-radius: 50%; background: #fdf2f8; border: 3px solid #fbcfe8; display: flex; align-items: center; justify-content: center; font-size: 34px; margin: 0 auto 16px auto; box-shadow: 0 4px 14px rgba(244,114,182,0.25);">
                🍄
            </div>

            <h2 style="font-size: 22px; margin: 0 0 8px 0; color: #1e293b; font-weight: 800;">Chào mừng bạn đến Phổi bạn không phải tôi!</h2>
            <p style="font-size: 13px; color: #64748b; margin: 0 0 20px 0; line-height: 1.5;">
                Vui lòng nhập tên của bạn để bắt đầu trò chuyện & chơi game:
            </p>

            <!-- Khung báo lỗi -->
            <div id="modal-name-error" style="display: none; background: #fef2f2; border: 1.5px solid #fca5a5; color: #dc2626; padding: 10px 14px; border-radius: 10px; font-size: 13px; font-weight: 600; margin-bottom: 16px; text-align: left;"></div>

            <form id="welcome-name-form" onsubmit="submitUserName(event)">
                <div style="text-align: left; margin-bottom: 16px;">
                    <label style="display: block; font-size: 13px; font-weight: 700; color: #334155; margin-bottom: 6px;">Tên của bạn (*):</label>
                    <input type="text" id="modal-username-input" placeholder="VD: Huy, MarioFan, GamePro..." required autocomplete="off"
                        style="width: 100%; padding: 12px 16px; border: 2px solid #fbcfe8; border-radius: 12px; font-size: 15px; outline: none; transition: border-color 0.2s;"
                        oninput="handleUsernameInput(this.value)"
                        onfocus="this.style.borderColor='#db2777'" onblur="this.style.borderColor='#fbcfe8'">
                    <span style="font-size: 11px; color: #94a3b8; margin-top: 4px; display: block;">* Tên không được trùng với người khác trong hệ thống</span>
                </div>

                <!-- Ô Mật khẩu hiển thị nếu tên là Admin -->
                <div id="modal-password-group" style="display: none; text-align: left; margin-bottom: 18px;">
                    <label style="display: block; font-size: 13px; font-weight: 700; color: #db2777; margin-bottom: 6px;">
                        🔒 Mật khẩu Quản trị:
                    </label>
                    <input type="password" id="modal-password-input" placeholder="Nhập mật khẩu quản trị..."
                        style="width: 100%; padding: 12px 16px; border: 2px solid #f43f5e; border-radius: 12px; font-size: 14px; outline: none; background: #fff1f2;">
                    <span style="font-size: 11px; color: #e11d48; margin-top: 4px; display: block;">* Vui lòng nhập mật khẩu tài khoản Quản trị để tiếp tục</span>
                </div>

                <button type="submit" id="btn-modal-submit" style="width: 100%; padding: 13px; background: #db2777; color: #ffffff; border: none; border-radius: 12px; font-size: 16px; font-weight: 800; cursor: pointer; box-shadow: 0 4px 14px rgba(219,39,119,0.3); transition: all 0.15s ease;"
                    onmouseover="this.style.background='#be185d'" onmouseout="this.style.background='#db2777'">
                    Bắt đầu ngay 🚀
                </button>
            </form>

        </div>

    </div>

    <script>
    function getCookie(name) {
        var value = "; " + document.cookie;
        var parts = value.split("; " + name + "=");
        if (parts.length === 2) return decodeURIComponent(parts.pop().split(";").shift());
        return null;
    }

    function openWelcomeNameModal() {
        var modal = document.getElementById("welcome-name-modal");
        if (modal) {
            modal.style.display = "flex";
            var input = document.getElementById("modal-username-input");
            if (input) setTimeout(function() { input.focus(); }, 150);
        }
    }

    document.addEventListener("DOMContentLoaded", function() {
        var currentUser = getCookie("chat_user");
        var modal = document.getElementById("welcome-name-modal");

        // Nếu chưa có cookie chat_user và không ở trang login admin riêng
        if (!currentUser && modal && window.location.pathname !== '/admin') {
            modal.style.display = "flex";
            var input = document.getElementById("modal-username-input");
            if (input) setTimeout(function() { input.focus(); }, 150);
        }
    });

    var TARGET_ADMIN_NAME = "<%= (typeof adminUsername !== 'undefined' ? adminUsername : 'admin').toLowerCase() %>";

    function handleUsernameInput(val) {
        var passGroup = document.getElementById("modal-password-group");
        var passInput = document.getElementById("modal-password-input");
        var btn = document.getElementById("btn-modal-submit");

        if (val.trim().toLowerCase() === TARGET_ADMIN_NAME) {
            if (passGroup) passGroup.style.display = "block";
            if (passInput) passInput.required = true;
            if (btn) btn.innerText = "🔑 Đăng nhập Quản trị";
        } else {
            if (passGroup) passGroup.style.display = "none";
            if (passInput) passInput.required = false;
            if (btn) btn.innerText = "Bắt đầu ngay 🚀";
        }
    }

    function submitUserName(e, allowRelogin) {
        if (e) e.preventDefault();
        var nameInput = document.getElementById("modal-username-input");
        var passInput = document.getElementById("modal-password-input");
        var errorDiv = document.getElementById("modal-name-error");
        var btn = document.getElementById("btn-modal-submit");

        var username = nameInput ? nameInput.value.trim() : "";
        var password = passInput ? passInput.value.trim() : "";

        if (!username) return;

        btn.innerText = "Đang kiểm tra...";
        btn.disabled = true;
        errorDiv.style.display = "none";

        fetch('/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: username, password: password, allowRelogin: allowRelogin === true })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                if (data.redirect) {
                    window.location.href = data.redirect;
                } else {
                    window.location.reload();
                }
            } else {
                btn.innerText = (username.toLowerCase() === TARGET_ADMIN_NAME) ? "🔑 Đăng nhập Quản trị" : "Bắt đầu ngay 🚀";
                btn.disabled = false;

                // Nếu tên đã có trên hệ thống, hiển thị nút cho phép tiếp tục vào
                if (data.isExistingUser) {
                    errorDiv.innerHTML = `
                        <div style="margin-bottom: 8px;">${data.error}</div>
                        <button type="button" onclick="submitUserName(null, true)" style="width: 100%; background: #22c55e; color: #ffffff; border: none; padding: 9px 12px; border-radius: 8px; font-weight: 700; font-size: 13px; cursor: pointer; box-shadow: 0 2px 6px rgba(34,197,94,0.3); display: flex; align-items: center; justify-content: center; gap: 6px;">
                            👋 Tiếp tục vào với tên "${data.existingUsername}"
                        </button>
                    `;
                } else {
                    errorDiv.innerText = data.error || "Có lỗi xảy ra, vui lòng thử lại!";
                }
                errorDiv.style.display = "block";

                if (data.requirePassword) {
                    var passGroup = document.getElementById("modal-password-group");
                    if (passGroup) passGroup.style.display = "block";
                    if (passInput) {
                        passInput.required = true;
                        passInput.focus();
                    }
                }
            }
        })
        .catch(function(err) {
            btn.innerText = "Bắt đầu ngay 🚀";
            btn.disabled = false;
            errorDiv.innerText = "Lỗi kết nối máy chủ!";
            errorDiv.style.display = "block";
        });
    }
    </script>

    <!-- Trạng thái quyền Admin toàn cục & Cài đặt nhạc hệ thống -->
    <script>
        window.IS_ADMIN = <%= (typeof isAdmin !== 'undefined' && isAdmin) ? 'true' : 'false' %>;
        window.SERVER_MUSIC_SETTING = <%- JSON.stringify(typeof activeMusicSetting !== 'undefined' && activeMusicSetting ? activeMusicSetting : { versionIndex: 0, speed: 1.0, customAudioUrl: null }) %>;
    </script>

    <!-- Hiệu ứng Mưa tiền xu & tiền giấy + Trình phát nhạc Graduation (NCT DREAM) + Minecraft Skeleton tuần tra -->
    <script src="/javascripts/money-rain.js"></script>
    <script src="/javascripts/music-player.js"></script>
    <script src="/javascripts/minecraft-skeleton.js"></script>
