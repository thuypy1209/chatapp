<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Phổi bạn không phải tôi' %></title>
    <!-- Google Fonts: Quicksand (Rounded Cute Aesthetic with Full Vietnamese Support) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<%
    // Nhận diện nếu trang hiện tại là Phòng Chat hoặc Game (Flappy / Mario)
    var currentTitle = typeof title !== 'undefined' ? title : '';
    var isAdminActive = /Quản trị/i.test(currentTitle);
    var isChatActive = !isAdminActive && /Phòng Chat|Trò chuyện/i.test(currentTitle);
    var isGameActive = !isAdminActive && !isChatActive && /Flappy|Cuộc Phiêu Lưu|Chơi game|Bangboo/i.test(currentTitle);
    var isHomeActive = !isAdminActive && !isChatActive && !isGameActive;
    var isAutoCollapsedPage = isGameActive || isChatActive;
    var isGamePage = isGameActive;
%>
<body class="<%= isGamePage ? 'game-page-active' : '' %>">

    <nav class="navbar" id="main-navbar">
        <a href="/" class="navbar-brand">
            <span class="brand-icon">🍄</span>
            <span class="brand-text">Phổi bạn không phải tôi</span>
        </a>

        <!-- Khối Menu bên phải trên PC & Điện Thoại -->
        <div class="navbar-right-box">
            <!-- Nút 3 Gạch (Hamburger Menu) áp dụng tất cả các trang, luôn nằm bên phải -->
            <button type="button" id="btn-nav-hamburger" class="btn-nav-hamburger" onclick="window.toggleNavMenu(event)" aria-label="Menu" title="Menu điều hướng">
                <span class="hamburger-box">
                    <span class="hamburger-line line-1"></span>
                    <span class="hamburger-line line-2"></span>
                    <span class="hamburger-line line-3"></span>
                </span>
                <span class="hamburger-text">Menu</span>
            </button>

            <!-- Menu dropdown điều hướng (Nổi ở trên các div bên dưới) -->
            <ul class="navbar-nav" id="navbar-nav-list">
                <li><a href="/" class="nav-item <%= isHomeActive ? 'active' : '' %>" data-route="/">🏠 Trang chủ <%- isHomeActive ? '<span class="nav-active-badge">📍 Đang xem</span>' : '' %></a></li>
                <li><a href="/chat" class="nav-item <%= isChatActive ? 'active' : '' %>" data-route="/chat">💬 Phòng Chat <%- isChatActive ? '<span class="nav-active-badge">📍 Đang xem</span>' : '' %></a></li>
                <li><a href="/flappy" class="nav-item nav-mario <%= isGameActive ? 'active' : '' %>" data-route="/flappy">🚀 Flappy Bangboo <%- isGameActive ? '<span class="nav-active-badge">📍 Đang xem</span>' : '' %></a></li>
                <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                    <li><a href="/admin" class="nav-item nav-admin <%= isAdminActive ? 'active' : '' %>" data-route="/admin">⚙️ Quản trị <%- isAdminActive ? '<span class="nav-active-badge">📍 Đang xem</span>' : '' %></a></li>
                <% } %>

                <!-- Thông tin người dùng / Nút đổi tên -->
                <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <li>
                        <div class="user-badge">
                            <span class="user-badge-name">
                                <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                                    <span class="user-avatar-emoji" id="nav-user-emoji" title="Quản trị viên">⭐</span>
                                <% } else { %>
                                    <span class="user-avatar-emoji" id="nav-user-emoji" title="Hình nhân vật thú cưng">
                                        <img src="/images/cat-avatar.png" alt="Avatar" class="user-avatar-img" onerror="this.style.display='none'; this.parentElement.innerText='<%= (typeof getEmojiForName === 'function') ? getEmojiForName(currentUser) : '🐱' %>';">
                                    </span>
                                <% } %>
                                <span id="nav-username-display"><%= currentUser %></span>
                            </span>
                            <a href="/auth/logout" title="Đổi tên / Đăng xuất" class="user-badge-logout" aria-label="Đăng xuất">
                                ✕
                            </a>
                        </div>
                    </li>
                <% } else { %>
                    <li>
                        <button type="button" class="btn-user-name" onclick="openWelcomeNameModal()">
                            👋 Nhập tên bạn
                        </button>
                    </li>
                <% } %>
            </ul>
        </div>
    </nav>

    <!-- Script Điều Khiển Menu 3 Gạch & Thu Gọn Navbar -->
    <script>
    (function() {
        var navbar = document.getElementById('main-navbar');
        var hamburgerBtn = document.getElementById('btn-nav-hamburger');
        var navList = document.getElementById('navbar-nav-list');

        // Bật / tắt hiển thị menu dạng 3 gạch
        window.toggleNavMenu = function(e) {
            if (e && e.stopPropagation) e.stopPropagation();
            if (!navbar) return;
            var isOpen = navbar.classList.contains('menu-open');
            if (isOpen) {
                navbar.classList.remove('menu-open');
                if (hamburgerBtn) hamburgerBtn.classList.remove('is-active');
            } else {
                navbar.classList.add('menu-open');
                if (hamburgerBtn) hamburgerBtn.classList.add('is-active');
            }
        };

        // Hàm tương thích ngược với code cũ (ví dụ khi vào fullscreen)
        window.toggleMainNavbar = function(forceOpen) {
            if (!navbar) return;
            if (forceOpen === true) {
                navbar.classList.add('menu-open');
                if (hamburgerBtn) hamburgerBtn.classList.add('is-active');
            } else if (forceOpen === false) {
                navbar.classList.remove('menu-open');
                if (hamburgerBtn) hamburgerBtn.classList.remove('is-active');
            } else {
                window.toggleNavMenu();
            }
        };

        // Đóng dropdown khi click ra ngoài vùng Navbar
        document.addEventListener('click', function(e) {
            if (!navbar || !navbar.classList.contains('menu-open')) return;
            if (navbar.contains(e.target)) return;
            navbar.classList.remove('menu-open');
            if (hamburgerBtn) hamburgerBtn.classList.remove('is-active');
        });

        // Đóng dropdown khi click vào bất kỳ liên kết / nút nào trong menu
        if (navList) {
            navList.addEventListener('click', function(e) {
                if (e.target.closest('a') || e.target.closest('button')) {
                    if (navbar) navbar.classList.remove('menu-open');
                    if (hamburgerBtn) hamburgerBtn.classList.remove('is-active');
                }
            });
        }

        // Tự động đánh dấu trang hiện tại trên Menu (Client-side sync)
        (function highlightActivePage() {
            var path = window.location.pathname.toLowerCase();
            var navItems = document.querySelectorAll('#navbar-nav-list a.nav-item');
            navItems.forEach(function(item) {
                var route = (item.getAttribute('data-route') || '').toLowerCase();
                var isCurrent = false;
                if (route === '/' && (path === '/' || path === '')) isCurrent = true;
                else if (route === '/chat' && path.indexOf('/chat') === 0) isCurrent = true;
                else if ((route === '/flappy' || route === '/mario') && (path.indexOf('/flappy') === 0 || path.indexOf('/mario') === 0)) isCurrent = true;
                else if (route === '/admin' && path.indexOf('/admin') === 0) isCurrent = true;

                if (isCurrent) {
                    item.classList.add('active');
                    if (!item.querySelector('.nav-active-badge')) {
                        var badge = document.createElement('span');
                        badge.className = 'nav-active-badge';
                        badge.innerText = '📍 Đang xem';
                        item.appendChild(badge);
                    }
                } else {
                    item.classList.remove('active');
                    var oldBadge = item.querySelector('.nav-active-badge');
                    if (oldBadge) oldBadge.remove();
                }
            });
        })();
    })();
    </script>
    <div class="cloud-retro cloud-1"></div>
    <div class="cloud-retro cloud-2"></div>
    <div class="cloud-retro cloud-3"></div>
    <div class="starry-sky"></div>
    <div class="mario-ground"></div>

    <!-- MODAL BẮT BUỘC NHẬP TÊN KHI VÀO TRANG -->
    <div id="welcome-name-modal">
        <div class="welcome-box">
            <div class="welcome-icon-circle" style="overflow: hidden; padding: 0; border: 3px solid #f472b6; box-shadow: 0 4px 14px rgba(244, 114, 182, 0.35); display: flex; align-items: center; justify-content: center; width: 68px; height: 68px; margin: 0 auto 12px auto; border-radius: 50%; background: #fdf2f8;">
                <img src="/images/cat-avatar.png" alt="Avatar Thú Cưng" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" onerror="this.style.display='none'; this.parentElement.innerText='🐱';">
            </div>

            <h2 class="welcome-title">Chào mừng bạn đến Phổi bạn không phải tôi!</h2>
            <p class="welcome-desc">
                Vui lòng nhập tên của bạn để bắt đầu trò chuyện & chơi game:
            </p>

            <!-- Khung báo lỗi -->
            <div id="modal-name-error" class="welcome-error-alert"></div>

            <form id="welcome-name-form" onsubmit="submitUserName(event)">
                <div class="welcome-form-group">
                    <label class="welcome-label">Tên của bạn (*):</label>
                    <input type="text" id="modal-username-input" class="welcome-input" placeholder="VD: Yen, MarioGame ..." required autocomplete="off"
                        oninput="handleUsernameInput(this.value)">
                    <span class="welcome-hint">* Tên không được trùng với người khác trong hệ thống</span>
                </div>

                <!-- Ô Mật khẩu hiển thị nếu tên là Admin -->
                <div id="modal-password-group" class="welcome-admin-group">
                    <label class="welcome-admin-label">
                        🔒 Mật khẩu Quản trị:
                    </label>
                    <input type="password" id="modal-password-input" class="welcome-admin-input" placeholder="Nhập mật khẩu quản trị...">
                    <span class="welcome-admin-hint">* Vui lòng nhập mật khẩu tài khoản Quản trị để tiếp tục</span>
                </div>

                <button type="submit" id="btn-modal-submit" class="welcome-submit-btn">
                    Bắt đầu ngay 🚀
                </button>
            </form>
        </div>
    </div>

    <script>
    function getCookie(name) {
        var value = "; " + document.cookie;
        var parts = value.split("; " + name + "=");
        if (parts.length === 2) return decodeURIComponent(parts.pop().split(";").shift());
        return null;
    }

    function openWelcomeNameModal() {
        var modal = document.getElementById("welcome-name-modal");
        if (modal) {
            modal.style.display = "flex";
            var input = document.getElementById("modal-username-input");
            if (input) setTimeout(function() { input.focus(); }, 150);
        }
    }

    document.addEventListener("DOMContentLoaded", function() {
        var currentUser = getCookie("chat_user");
        var modal = document.getElementById("welcome-name-modal");

        // Nếu chưa có cookie chat_user và không ở trang login admin riêng
        if (!currentUser && modal && window.location.pathname !== '/admin') {
            modal.style.display = "flex";
            var input = document.getElementById("modal-username-input");
            if (input) setTimeout(function() { input.focus(); }, 150);
        }
    });

    var TARGET_ADMIN_NAME = "<%= (typeof adminUsername !== 'undefined' ? adminUsername : 'admin').toLowerCase() %>";

    function handleUsernameInput(val) {
        var passGroup = document.getElementById("modal-password-group");
        var passInput = document.getElementById("modal-password-input");
        var btn = document.getElementById("btn-modal-submit");

        if (val.trim().toLowerCase() === TARGET_ADMIN_NAME) {
            if (passGroup) passGroup.style.display = "block";
            if (passInput) passInput.required = true;
            if (btn) btn.innerText = "🔑 Đăng nhập Quản trị";
        } else {
            if (passGroup) passGroup.style.display = "none";
            if (passInput) passInput.required = false;
            if (btn) btn.innerText = "Bắt đầu ngay 🚀";
        }
    }

    function submitUserName(e, allowRelogin) {
        if (e) e.preventDefault();
        var nameInput = document.getElementById("modal-username-input");
        var passInput = document.getElementById("modal-password-input");
        var errorDiv = document.getElementById("modal-name-error");
        var btn = document.getElementById("btn-modal-submit");

        var username = nameInput ? nameInput.value.trim() : "";
        var password = passInput ? passInput.value.trim() : "";

        if (!username) return;

        btn.innerText = "Đang kiểm tra...";
        btn.disabled = true;
        errorDiv.style.display = "none";

        fetch('/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: username, password: password, allowRelogin: allowRelogin === true })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                if (data.redirect) {
                    window.location.href = data.redirect;
                } else {
                    window.location.reload();
                }
            } else {
                btn.innerText = (username.toLowerCase() === TARGET_ADMIN_NAME) ? "🔑 Đăng nhập Quản trị" : "Bắt đầu ngay 🚀";
                btn.disabled = false;

                // Nếu tên đã có trên hệ thống, hiển thị nút cho phép tiếp tục vào
                if (data.isExistingUser) {
                    errorDiv.innerHTML = `
                        <div class="welcome-error-msg">${data.error}</div>
                        <button type="button" onclick="submitUserName(null, true)" class="welcome-override-btn">
                            👋 Tiếp tục vào với tên "${data.existingUsername}"
                        </button>
                    `;
                } else {
                    errorDiv.innerText = data.error || "Có lỗi xảy ra, vui lòng thử lại!";
                }
                errorDiv.style.display = "block";

                if (data.requirePassword) {
                    var passGroup = document.getElementById("modal-password-group");
                    if (passGroup) passGroup.style.display = "block";
                    if (passInput) {
                        passInput.required = true;
                        passInput.focus();
                    }
                }
            }
        })
        .catch(function(err) {
            btn.innerText = "Bắt đầu ngay 🚀";
            btn.disabled = false;
            errorDiv.innerText = "Lỗi kết nối máy chủ!";
            errorDiv.style.display = "block";
        });
    }
    </script>

    <!-- Trạng thái quyền Admin toàn cục & Cài đặt nhạc hệ thống -->
    <script>
        window.IS_ADMIN = <%= (typeof isAdmin !== 'undefined' && isAdmin) ? 'true' : 'false' %>;
        window.IS_CHAT_OR_GAME_PAGE = <%= (typeof isAutoCollapsedPage !== 'undefined' && isAutoCollapsedPage) ? 'true' : 'false' %>;
        window.SERVER_MUSIC_SETTING = <%- JSON.stringify(typeof activeMusicSetting !== 'undefined' && activeMusicSetting ? activeMusicSetting : { versionIndex: 0, speed: 1.0, customAudioUrl: null }) %>;
    </script>

    <!-- Emoji Avatar dễ thương tự động theo tên người dùng -->
    <script src="/javascripts/emoji-avatar.js"></script>

    <!-- Hiệu ứng Mưa tiền xu & tiền giấy + Trình phát nhạc Graduation (NCT DREAM) -->
    <script src="/javascripts/money-rain.js"></script>
    <script src="/javascripts/music-player.js"></script>
