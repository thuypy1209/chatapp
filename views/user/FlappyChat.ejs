<%- include('../partials/header') %>

<div class="mario-play-chat-wrapper">

    <!-- Thanh tiêu đề Game: Chỉ để lại tên theo đúng yêu cầu -->
    <div class="mario-header-bar" id="mario-header-bar">
        <div class="mario-header-title-box">
            <span class="mario-header-icon">🚀</span>
            <h1 class="mario-header-h1">Flappy Bangboo: Cuộc Phiêu Lưu Trên Không</h1>
        </div>
    </div>

    <!-- KHUNG CHÍNH: DUY NHẤT TRÒ CHƠI FLAPPY BANGBOO (CĂN GIỮA MÀN HÌNH) -->
    <div class="game-column" style="width: 100%; max-width: 1400px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px;">
        <div id="mario-game-container" class="game-card">
            <!-- Thanh công cụ điều khiển nhanh NẰM TRONG KHUNG CHƠI GAME (Âm thanh, Chơi lại, Toàn màn hình) -->
            <div class="game-hud-toolbar">
                <button type="button" id="btn-toggle-sound" class="game-hud-btn btn-hud-sound" onclick="window.toggleGameAudio(event)" onpointerdown="event.stopPropagation()" title="Bật / Tắt âm thanh">
                    <span id="sound-icon">🔊</span> <span class="hud-btn-label" id="sound-text">Âm thanh: Bật</span>
                </button>
                <button type="button" id="btn-restart-game" class="game-hud-btn btn-hud-restart" onclick="window.restartFlappyGame(event)" onpointerdown="event.stopPropagation()" title="Chơi lại ván mới">
                    🔄 <span class="hud-btn-label">Chơi lại</span>
                </button>
                <button type="button" id="btn-toggle-fullscreen" class="game-hud-btn btn-mario-fullscreen-toggle btn-hud-fs" onclick="window.toggleFullscreenMario('mario-game-container', event)" onpointerdown="event.stopPropagation()" title="Toàn màn hình">
                    <span class="fs-icon">⛶</span> <span class="fs-text hud-btn-label">Toàn màn hình</span>
                </button>
            </div>

            <!-- Nút thoát toàn màn hình (nổi góc trên bên phải, chỉ hiện khi fullscreen) -->
            <button type="button" class="game-hud-exit-btn" onclick="window.exitFullscreenMario('mario-game-container')" onpointerdown="event.stopPropagation()" title="Thoát toàn màn hình (ESC)">
                ✕ <span class="hud-btn-label">Thoát (ESC)</span>
            </button>

            <!-- Màn hình chơi Game Flappy Bangboo (DOM / GPU Hardware Accelerated - Không sử dụng Canvas) -->
            <div id="mario-canvas" class="game-canvas game-dom-viewport" tabindex="0"></div>
        </div>

        <!-- Bàn phím điều khiển ảo cho Di động & Máy tính -->
    </div>
</div>

<script src="/javascripts/flappy.js"></script>
<script>
function initMarioApp() {
    if (window.marioInstance) return;

    // Tắt hoàn toàn hiệu ứng mưa tiền để giải phóng GPU cho game
    if (window.moneyRainInstance) {
        window.moneyRainInstance.toggle(false);
    }

    // Khởi tạo Game Flappy Bangboo
    var game = new window.MarioGame('mario-canvas');
    window.marioInstance = game;
    window.flappyInstance = game;

    // Gán sự kiện cho các nút bay với pointerdown siêu nhạy (zero latency)
    var triggerJump = function(e) {
        if (e && e.cancelable) e.preventDefault();
        window.flapGameHero();
    };

    var btnJump = document.getElementById('vkey-jump');
    if (btnJump) {
        btnJump.addEventListener('pointerdown', triggerJump);
    }

    var hudJump = document.getElementById('hud-vkey-jump');
    if (hudJump) {
        hudJump.addEventListener('pointerdown', triggerJump);
    }
}
window.initMarioApp = initMarioApp;

if (document.readyState === 'loading') {
    document.addEventListener("DOMContentLoaded", initMarioApp);
} else {
    initMarioApp();
}
</script>

<%- include('../partials/footer') %>