<%- include('../partials/header') %>

<div class="mario-play-chat-wrapper" style="max-width: 960px; margin: 15px auto 40px auto; padding: 0 15px;">

    <!-- Thanh tiêu đề & Công cụ điều khiển nhanh -->
    <div class="mario-header-bar" style="max-width: 100%;">
        <div class="mario-header-title-box">
            <span class="mario-header-icon">🚀</span>
            <div>
                <div class="mario-header-title-flex">
                    <h1 class="mario-header-h1">Flappy Bangboo: Cuộc Phiêu Lưu Trên Không</h1>
                </div>
                <p class="mario-header-subtitle">Điều khiển chú Bangboo cưỡi mô tô (Zenless Zone Zero) vượt qua các cột ống nước retro!</p>
            </div>
        </div>

        <div class="mario-header-tools">
            <button id="btn-toggle-sound" type="button" class="tool-btn btn-mario-sound" onclick="window.toggleGameAudio()" title="Bật / Tắt âm thanh trò chơi">
                <span id="sound-icon">🔊</span> <span id="sound-text">Âm thanh: Bật</span>
            </button>
            <button id="btn-restart-game" type="button" class="tool-btn btn-mario-restart" onclick="window.restartFlappyGame()" title="Chơi lại ván mới">
                🔄 Chơi lại
            </button>
            <button id="btn-toggle-fullscreen" type="button" class="tool-btn btn-mario-fullscreen-toggle btn-mario-fs" onclick="window.toggleFullscreenMario('mario-game-container')" title="Bật chế độ toàn màn hình để chơi">
                <span class="fs-icon">⛶</span> <span class="fs-text">Toàn màn hình</span>
            </button>
        </div>
    </div>

    <!-- KHUNG CHÍNH: DUY NHẤT TRÒ CHƠI FLAPPY BANGBOO (CĂN GIỮA MÀN HÌNH) -->
    <div class="game-column" style="width: 100%; max-width: 960px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px;">
        <div id="mario-game-container" class="game-card" style="width: 100%; border-radius: 20px; overflow: hidden; box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);">
            <!-- Fullscreen Top Header Bar -->
            <div class="mario-fs-header">
                <div class="mario-fs-title-box">
                    <span class="mario-fs-icon">🚀</span>
                    <span class="mario-fs-text-title">Flappy Bangboo (Zenless Zone Zero)</span>
                    <span class="mario-fps-badge mario-fs-fps-badge">⚡ 120 FPS</span>
                    <span class="mario-fs-guide-text">(Chạm màn hình / Chuột hoặc Phím Space để bay)</span>
                </div>
                <div class="mario-fs-actions">
                    <button type="button" id="fs-sound-btn" class="fs-sound-btn" onclick="window.toggleGameAudio()" title="Bật / Tắt âm thanh">
                        🔊
                    </button>
                    <button type="button" class="fs-restart-btn" onclick="window.restartFlappyGame()" title="Chơi lại">
                        🔄 Chơi lại
                    </button>
                    <button type="button" class="btn-exit-fullscreen" onclick="window.exitFullscreenMario('mario-game-container')" title="Thoát toàn màn hình (ESC)">
                        ✕ Thoát (ESC)
                    </button>
                </div>
            </div>

            <!-- Canvas Game Flappy Bird -->
            <canvas id="mario-canvas" class="game-canvas" tabindex="0"></canvas>

            <!-- Phím ảo nổi HUD khi bật Toàn màn hình (Fullscreen) -->
            <div class="mario-touch-hud" style="justify-content: center; gap: 12px;">
                <button type="button" id="hud-vkey-jump" class="hud-key hud-key-jump" style="padding: 12px 28px; font-size: 16px; border-radius: 14px; background: linear-gradient(135deg, #f59e0b, #ea580c); color: #fff; font-weight: 800; border: none; box-shadow: 0 4px 15px rgba(234,88,12,0.4);" onmousedown="window.flapGameHero();" ontouchstart="window.flapGameHero(); event.preventDefault();">🚀 BAY LÊN (Space / Chạm)</button>
                <button type="button" class="hud-key hud-key-nav" style="padding: 12px 18px; border-radius: 14px;" onclick="window.restartFlappyGame()" title="Chơi lại">🔄</button>
            </div>
        </div>

        <!-- Bàn phím điều khiển ảo cho Di động & Máy tính -->
        <div class="controls-card" style="display: flex; gap: 14px; align-items: center; justify-content: space-between; padding: 14px 20px;">
            <!-- Nút bay to bản -->
            <button type="button" class="virtual-key virtual-key-jump" id="vkey-jump" style="flex: 1; padding: 15px; font-size: 16px; font-weight: 800; border-radius: 14px; background: linear-gradient(135deg, #f59e0b, #ea580c); color: #fff; border: none; cursor: pointer; box-shadow: 0 4px 14px rgba(234,88,12,0.3); transition: transform 0.1s ease;" onmousedown="window.flapGameHero();" ontouchstart="window.flapGameHero(); event.preventDefault();" title="Bấm để bay lên (Space / Chạm)">
                🚀 BAY LÊN (Phím Space / Chuột / Chạm màn hình)
            </button>
            <button type="button" class="virtual-key" style="padding: 15px 24px; font-size: 15px; font-weight: 700; border-radius: 14px; background: #fff; border: 1.5px solid #cbd5e1; cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,0.06);" onclick="window.restartFlappyGame()" title="Chơi lại ván mới">
                🔄 Chơi lại
            </button>
        </div>
    </div>
</div>

<script src="/javascripts/flappy.js"></script>
<script>
function initMarioApp() {
    if (window.marioInstance) return;
    // Khởi tạo Game Flappy Bangboo
    var game = new window.MarioGame('mario-canvas');
    window.marioInstance = game;
    window.flappyInstance = game;

    // Gán sự kiện cho nút bay
    var btnJump = document.getElementById('vkey-jump');
    if (btnJump) {
        var triggerJump = function(e) {
            e.preventDefault();
            window.flapGameHero();
        };
        btnJump.addEventListener('mousedown', triggerJump);
        btnJump.addEventListener('touchstart', triggerJump, { passive: false });
    }
}

if (document.readyState === 'loading') {
    document.addEventListener("DOMContentLoaded", initMarioApp);
} else {
    initMarioApp();
}
</script>

<%- include('../partials/footer') %>