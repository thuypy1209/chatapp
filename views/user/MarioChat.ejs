<%- include('../partials/header') %>

<div class="mario-play-chat-wrapper">

    <!-- Thanh tiêu đề Game: Chỉ để lại tên theo đúng yêu cầu -->
    <div class="mario-header-bar" id="mario-header-bar">
        <div class="mario-header-title-box">
            <span class="mario-header-icon">🚀</span>
            <h1 class="mario-header-h1">Flappy Bangboo: Cuộc Phiêu Lưu Trên Không</h1>
        </div>
    </div>

    <!-- KHUNG CHÍNH: DUY NHẤT TRÒ CHƠI FLAPPY BANGBOO (CĂN GIỮA MÀN HÌNH) -->
    <div class="game-column" style="width: 100%; max-width: 1400px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px;">
        <div id="mario-game-container" class="game-card">
            <!-- Thanh công cụ điều khiển nhanh NẰM TRONG KHUNG CHƠI GAME (Âm thanh, Chơi lại, Toàn màn hình) -->
            <div class="game-hud-toolbar">
                <button type="button" id="btn-toggle-sound" class="game-hud-btn btn-hud-sound" onclick="window.toggleGameAudio(event)" onpointerdown="event.stopPropagation()" title="Bật / Tắt âm thanh">
                    <span id="sound-icon">🔊</span> <span class="hud-btn-label" id="sound-text">Âm thanh: Bật</span>
                </button>
                <button type="button" id="btn-restart-game" class="game-hud-btn btn-hud-restart" onclick="window.restartFlappyGame(event)" onpointerdown="event.stopPropagation()" title="Chơi lại ván mới">
                    🔄 <span class="hud-btn-label">Chơi lại</span>
                </button>
                <button type="button" id="btn-toggle-fullscreen" class="game-hud-btn btn-mario-fullscreen-toggle btn-hud-fs" onclick="window.toggleFullscreenMario('mario-game-container', event)" onpointerdown="event.stopPropagation()" title="Toàn màn hình">
                    <span class="fs-icon">⛶</span> <span class="fs-text hud-btn-label">Toàn màn hình</span>
                </button>
            </div>

            <!-- Fullscreen Top Header Bar -->
            <div class="mario-fs-header">
                <div class="mario-fs-title-box">
                    <span class="mario-fs-icon">🚀</span>
                    <span class="mario-fs-text-title">Flappy Bangboo <span class="fs-extra-title">(Zenless Zone Zero)</span></span>
                    <span class="mario-fps-badge mario-fs-fps-badge">⚡ 120 FPS</span>
                    <span class="mario-fs-guide-text">(Chạm màn hình / Chuột hoặc Phím Space để bay)</span>
                </div>
                <div class="mario-fs-actions">
                    <button type="button" id="fs-sound-btn" class="fs-sound-btn" onclick="window.toggleGameAudio(event)" title="Bật / Tắt âm thanh">
                        🔊
                    </button>
                    <button type="button" class="fs-restart-btn" onclick="window.restartFlappyGame(event)" title="Chơi lại">
                        🔄 <span class="fs-btn-label">Chơi lại</span>
                    </button>
                    <button type="button" class="btn-exit-fullscreen" onclick="window.exitFullscreenMario('mario-game-container')" title="Thoát toàn màn hình (ESC)">
                        ✕ <span class="fs-btn-label">Thoát (ESC)</span>
                    </button>
                </div>
            </div>

            <!-- Màn hình chơi Game Flappy Bangboo (DOM / GPU Hardware Accelerated - Không sử dụng Canvas) -->
            <div id="mario-canvas" class="game-canvas game-dom-viewport" tabindex="0"></div>

            <!-- Phím ảo nổi HUD khi bật Toàn màn hình (Fullscreen) -->
            <div class="mario-touch-hud" style="justify-content: center; gap: 12px;">
                <button type="button" id="hud-vkey-jump" class="hud-key hud-key-jump" style="padding: 12px 28px; font-size: 16px; border-radius: 14px; background: linear-gradient(135deg, #f59e0b, #ea580c); color: #fff; font-weight: 800; border: none; box-shadow: 0 4px 15px rgba(234,88,12,0.4); touch-action: manipulation;">🚀 BAY LÊN (Space / Chạm)</button>
                <button type="button" class="hud-key hud-key-nav" style="padding: 12px 18px; border-radius: 14px;" onclick="window.restartFlappyGame()" title="Chơi lại">🔄</button>
            </div>
        </div>

        <!-- Bàn phím điều khiển ảo cho Di động & Máy tính -->
        <div class="controls-card" style="display: flex; gap: 14px; align-items: center; justify-content: space-between; padding: 14px 20px;">
            <!-- Nút bay to bản -->
            <button type="button" class="virtual-key virtual-key-jump" id="vkey-jump" style="flex: 1; padding: 15px; font-size: 16px; font-weight: 800; border-radius: 14px; background: linear-gradient(135deg, #f59e0b, #ea580c); color: #fff; border: none; cursor: pointer; box-shadow: 0 4px 14px rgba(234,88,12,0.3); transition: transform 0.1s ease; touch-action: manipulation;" title="Bấm để bay lên (Space / Chạm)">
                🚀 BAY LÊN (Phím Space / Chuột / Chạm màn hình)
            </button>
            <button type="button" class="virtual-key" style="padding: 15px 24px; font-size: 15px; font-weight: 700; border-radius: 14px; background: #fff; border: 1.5px solid #cbd5e1; cursor: pointer; box-shadow: 0 2px 6px rgba(0,0,0,0.06);" onclick="window.restartFlappyGame()" title="Chơi lại ván mới">
                🔄 Chơi lại
            </button>
        </div>
    </div>
</div>

<script src="/javascripts/flappy.js"></script>
<script>
function initMarioApp() {
    if (window.marioInstance) return;

    if (window.moneyRainInstance) {
        window.moneyRainInstance.toggle(false);
    }

    // Khởi tạo Game Flappy Bangboo
    var game = new window.MarioGame('mario-canvas');
    window.marioInstance = game;
    window.flappyInstance = game;

    // Gán sự kiện cho các nút bay với pointerdown siêu nhạy (zero latency)
    var triggerJump = function(e) {
        if (e && e.cancelable) e.preventDefault();
        window.flapGameHero();
    };

    var btnJump = document.getElementById('vkey-jump');
    if (btnJump) {
        btnJump.addEventListener('pointerdown', triggerJump);
    }

    var hudJump = document.getElementById('hud-vkey-jump');
    if (hudJump) {
        hudJump.addEventListener('pointerdown', triggerJump);
    }
}

if (document.readyState === 'loading') {
    document.addEventListener("DOMContentLoaded", initMarioApp);
} else {
    initMarioApp();
}
</script>

<%- include('../partials/footer') %>