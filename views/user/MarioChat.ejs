<%- include('../partials/header') %>

<div class="mario-play-chat-wrapper" style="max-width: 1350px; margin: 15px auto 40px auto; padding: 0 15px; position: relative; z-index: 5;">

    <!-- Thanh tiêu đề & Công cụ điều khiển nhanh -->
    <div style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); padding: 12px 20px; border-radius: 16px; margin-bottom: 15px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; border: 2px solid #fbcfe8; box-shadow: 0 4px 12px rgba(244, 114, 182, 0.15);">
        <div style="display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 28px; line-height: 1;">🍄</span>
            <div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <h1 style="font-size: 19px; margin: 0; color: #1e293b; font-weight: 800;">Super Mario Bros & Chat Trực Tuyến</h1>
                    <span style="background: rgba(16, 185, 129, 0.15); border: 1.5px solid #10b981; color: #059669; padding: 2px 8px; border-radius: 8px; font-size: 11px; font-weight: 800;">⚡ 120 FPS</span>
                </div>
                <p style="font-size: 12px; margin: 0; color: #64748b;">Vừa thưởng thức game Mario 2D retro cổ điển, vừa trò chuyện tương tác trực tiếp!</p>
            </div>
        </div>

        <div style="display: flex; align-items: center; gap: 8px;">
            <button id="btn-toggle-skin" type="button" class="tool-btn" style="background: #ecfdf5; border: 2px solid #10b981; color: #047857; padding: 8px 14px; border-radius: 8px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all 0.2s ease;">
                <span id="skin-icon">🟩</span> <span id="skin-text">Chế độ: Minecraft Edition</span>
            </button>
            <button id="btn-toggle-sound" type="button" class="tool-btn" style="background: #fdf2f8; border: 2px solid #f472b6; color: #db2777; padding: 8px 14px; border-radius: 8px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                <span id="sound-icon">🔊</span> <span id="sound-text">Âm thanh: Bật</span>
            </button>
            <button id="btn-restart-game" type="button" class="tool-btn" style="background: #fef08a; border: 2px solid #facc15; color: #854d0e; padding: 8px 14px; border-radius: 8px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                🔄 Chơi lại
            </button>
            <button id="btn-toggle-fullscreen" type="button" class="tool-btn btn-mario-fullscreen-toggle" onclick="toggleFullscreenMario('mario-game-container')" title="Bật chế độ toàn màn hình để chơi" style="background: #eff6ff; border: 2px solid #3b82f6; color: #1d4ed8; padding: 8px 14px; border-radius: 8px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all 0.2s ease;">
                <span class="fs-icon">⛶</span> <span class="fs-text">Toàn màn hình</span>
            </button>
        </div>
    </div>

    <!-- Khung chính 2 cột: Trò chơi Mario (Trái) & Phòng Chat (Phải) -->
    <div class="mario-grid-container" style="display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(360px, 1fr); gap: 20px; align-items: start;">

        <!-- CỘT 1: KHUNG GAME MARIO -->
        <div class="game-column" style="display: flex; flex-direction: column; gap: 12px;">
            <div id="mario-game-container" class="game-card" style="background: #0f172a; border-radius: 20px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.25); border: 4px solid #38bdf8; position: relative;">
                <!-- Fullscreen Top Header Bar -->
                <div class="mario-fs-header" style="display: none;">
                    <div style="display: flex; align-items: center; gap: 8px; color: #fff;">
                        <span style="font-size: 16px;">🎮</span>
                        <span style="font-size: 14px; font-weight: 700;">Super Mario Bros & Minecraft</span>
                        <span style="background: rgba(16, 185, 129, 0.2); border: 1px solid #10b981; color: #34d399; padding: 2px 7px; border-radius: 6px; font-size: 10px; font-weight: 800;">⚡ 120 FPS</span>
                        <span style="font-size: 11px; color: #94a3b8; margin-left: 6px;">(Di chuyển: A/D/← → | Nhảy: Space/W)</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <button type="button" id="fs-skin-btn" onclick="document.getElementById('btn-toggle-skin').click()" style="background: #065f46; border: 1.5px solid #10b981; color: #a7f3d0; padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 5px;">
                            <span id="fs-skin-icon">🟩</span> <span id="fs-skin-text">Đổi Skin</span>
                        </button>
                        <button type="button" id="fs-sound-btn" onclick="document.getElementById('btn-toggle-sound').click()" style="background: #334155; border: 1.5px solid #64748b; color: #fff; padding: 5px 10px; border-radius: 6px; font-size: 12px; cursor: pointer;">
                            🔊
                        </button>
                        <button type="button" onclick="document.getElementById('btn-restart-game').click()" style="background: #854d0e; border: 1.5px solid #facc15; color: #fef08a; padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer;">
                            🔄 Chơi lại
                        </button>
                        <button type="button" class="btn-exit-fullscreen" onclick="exitFullscreenMario()">
                            ✕ Thoát (ESC)
                        </button>
                    </div>
                </div>

                <!-- Canvas Game Mario -->
                <canvas id="mario-canvas" style="display: block; width: 100%; height: auto; aspect-ratio: 16/9; background: #5c94fc; cursor: pointer; outline: none;" tabindex="0"></canvas>
            </div>

            <!-- Bàn phím điều khiển ảo (Hỗ trợ chuột & di động) -->
            <div class="controls-card" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); padding: 14px 18px; border-radius: 16px; border: 2px solid #fbcfe8; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px;">
                <div style="font-size: 13px; color: #475569; display: flex; align-items: center; gap: 6px;">
                    <span style="font-weight: 700; color: #db2777;">🎮 Phím chơi:</span>
                    <span>Di chuyển: <b>A/D</b> hoặc <b>← →</b> | Nhảy: <b>Phím Cách</b> hoặc <b>W/↑</b> | Chạy nhanh: <b>Shift</b></span>
                </div>

                <!-- Nút bấm ảo -->
                <div style="display: flex; gap: 8px;">
                    <button type="button" class="virtual-key" id="vkey-left" style="background: #f1f5f9; border: 2px solid #cbd5e1; width: 42px; height: 38px; border-radius: 8px; font-weight: bold; font-size: 16px; cursor: pointer;">◀</button>
                    <button type="button" class="virtual-key" id="vkey-right" style="background: #f1f5f9; border: 2px solid #cbd5e1; width: 42px; height: 38px; border-radius: 8px; font-weight: bold; font-size: 16px; cursor: pointer;">▶</button>
                    <button type="button" class="virtual-key" id="vkey-jump" style="background: #fed7aa; border: 2px solid #fb923c; color: #c2410c; padding: 0 16px; height: 38px; border-radius: 8px; font-weight: bold; font-size: 14px; cursor: pointer;">▲ Nhảy (Space)</button>
                </div>
            </div>
        </div>

        <!-- CỘT 2: KHUNG CHAT MARIO -->
        <div class="chat-column">
            <div class="chat-card" style="background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(10px); border-radius: 20px; box-shadow: 0 8px 24px rgba(0,0,0,0.08); border: 2px solid #fbcfe8; display: flex; flex-direction: column; height: 580px; overflow: hidden;">
                
                <!-- Chat Header -->
                <div style="background: #fff; padding: 14px 18px; border-bottom: 2px solid #fdf2f8; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <div id="chat-hero-avatar" style="width: 40px; height: 40px; border-radius: 50%; background: #dbeafe; border: 2px solid #38bdf8; display: flex; align-items: center; justify-content: center; font-size: 20px;">
                            ⛏️
                        </div>
                        <div>
                            <h2 id="chat-hero-name" style="font-size: 15px; margin: 0; color: #1e293b; font-weight: 700;">Steve (Minecraft)</h2>
                            <span style="font-size: 11px; color: #22c55e; font-weight: 600;">● Đang online trong game</span>
                        </div>
                    </div>
                    <span style="font-size: 11px; background: #fdf2f8; color: #db2777; font-weight: 700; padding: 4px 10px; border-radius: 12px; border: 1px solid #fbcfe8;">
                        Interactive Live Chat
                    </span>
                </div>

                <!-- Chat Messages Scroll Area -->
                <div id="mario-message-box" style="flex: 1; padding: 16px; overflow-y: auto; background: #fdfbf7; display: flex; flex-direction: column; gap: 12px;">
                    
                    <!-- Lời chào đầu tiên từ Hero -->
                    <div class="message bot" style="background: #ffffff; border: 1px solid #fbcfe8; border-radius: 14px 14px 14px 4px; padding: 12px 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); font-size: 14px; color: #1e293b; line-height: 1.5; max-width: 90%;">
                        <b id="chat-welcome-bot-title" style="color: #0284c7; display: flex; align-items: center; gap: 5px; margin-bottom: 4px;">
                            <span>⛏️</span> Steve (Minecraft Edition):
                        </b>
                        <span id="chat-welcome-bot-msg">Xin chào! Tôi là Steve trong thế giới Mario x Minecraft! Hãy nhấp vào màn hình để điều khiển tôi vung Kiếm Kim Cương 🗡️, vượt qua Cổng Nether và hạ gục Creeper 💥! Bạn có thể vừa chơi vừa chat cùng tôi nhé! ⭐</span>
                    </div>

                </div>

                <!-- Gợi ý câu hỏi nhanh -->
                <div id="mario-quick-questions" style="padding: 10px 14px; background: #ffffff; border-top: 1px dashed #fbcfe8; flex-shrink: 0; max-height: 120px; overflow-y: auto; display: flex; flex-direction: column; gap: 6px;">
                    <div style="font-size: 11px; font-weight: 700; color: #0284c7;">💡 Gợi ý hỏi đáp:</div>
                    <button type="button" class="quick-btn" onclick="sendQuickMessage('Có những bản Mario x Minecraft nào chơi được và đẹp nhất?')" style="text-align: left; background: #ecfdf5; border: 1px solid #a7f3d0; padding: 6px 10px; border-radius: 8px; font-size: 12px; color: #047857; cursor: pointer;">
                        ⛏️ Có những bản Mario x Minecraft nào chơi được & đẹp nhất?
                    </button>
                    <button type="button" class="quick-btn" onclick="sendQuickMessage('Làm thế nào để điều khiển Steve nhảy và chém Creeper?')" style="text-align: left; background: #f0fdf4; border: 1px solid #bbf7d0; padding: 6px 10px; border-radius: 8px; font-size: 12px; color: #15803d; cursor: pointer;">
                        💥 Làm thế nào để điều khiển Steve nhảy chém Creeper?
                    </button>
                    <button type="button" class="quick-btn" onclick="sendQuickMessage('Làm thế nào để đào Kim Cương Diamond?')" style="text-align: left; background: #f0f9ff; border: 1px solid #bae6fd; padding: 6px 10px; border-radius: 8px; font-size: 12px; color: #0284c7; cursor: pointer;">
                        💎 Làm thế nào để đào được Kim Cương Diamond?
                    </button>
                    <button type="button" class="quick-btn" onclick="sendQuickMessage('Làm thế nào để điều khiển Mario nhảy cao?')" style="text-align: left; background: #fdf2f8; border: 1px solid #fbcfe8; padding: 6px 10px; border-radius: 8px; font-size: 12px; color: #db2777; cursor: pointer;">
                        🍄 Làm thế nào để điều khiển Mario nhảy cao?
                    </button>
                </div>

                <!-- Input nhắn tin trực tiếp -->
                <div style="padding: 12px 14px; background: #ffffff; border-top: 1px solid #f0eae1; flex-shrink: 0;">
                    <form id="mario-chat-form" style="display: flex; gap: 8px;" onsubmit="handleSendChat(event)">
                        <input type="text" id="mario-chat-input" placeholder="Nhập tin nhắn để chat với Mario..." autocomplete="off" style="flex: 1; padding: 10px 14px; border: 2px solid #fbcfe8; border-radius: 10px; font-size: 13px; outline: none; transition: border-color 0.2s;" onfocus="this.style.borderColor='#db2777'" onblur="this.style.borderColor='#fbcfe8'" />
                        <button type="submit" style="background: #db2777; color: #fff; border: none; padding: 10px 18px; border-radius: 10px; font-weight: 700; font-size: 13px; cursor: pointer; transition: background 0.15s ease;" onmouseover="this.style.background='#be185d'" onmouseout="this.style.background='#db2777'">
                            Gửi
                        </button>
                    </form>
                </div>

            </div>
        </div>

    </div>
</div>

<script src="/javascripts/mario.js"></script>
<script>
function initMarioApp() {
    if (window.marioInstance) return;
    // 1. Khởi tạo Game Mario
    var game = new window.MarioGame('mario-canvas');
    window.marioInstance = game;

    // 2. Chuyển đổi Giao diện (Skin: Minecraft Edition / Mario Cổ Điển)
    var btnSkin = document.getElementById('btn-toggle-skin');
    var skinIcon = document.getElementById('skin-icon');
    var skinText = document.getElementById('skin-text');

    function updateSkinUI(currentSkin) {
        var avatarBox = document.getElementById('chat-hero-avatar');
        var nameBox = document.getElementById('chat-hero-name');
        var welcomeTitle = document.getElementById('chat-welcome-bot-title');
        var welcomeMsg = document.getElementById('chat-welcome-bot-msg');
        var fsSkinIcon = document.getElementById('fs-skin-icon');
        var fsSkinText = document.getElementById('fs-skin-text');
        var fsSkinBtn = document.getElementById('fs-skin-btn');

        if (currentSkin === 'minecraft') {
            if (skinIcon) skinIcon.innerText = '🟩';
            if (skinText) skinText.innerText = 'Chế độ: Minecraft Edition';
            if (fsSkinIcon) fsSkinIcon.innerText = '🟩';
            if (fsSkinText) fsSkinText.innerText = 'Đổi Skin: Mario';
            if (fsSkinBtn) {
                fsSkinBtn.style.background = '#065f46';
                fsSkinBtn.style.borderColor = '#10b981';
                fsSkinBtn.style.color = '#a7f3d0';
            }
            if (btnSkin) {
                btnSkin.style.background = '#ecfdf5';
                btnSkin.style.borderColor = '#10b981';
                btnSkin.style.color = '#047857';
            }
            if (avatarBox) {
                avatarBox.innerText = '⛏️';
                avatarBox.style.background = '#dbeafe';
                avatarBox.style.borderColor = '#38bdf8';
            }
            if (nameBox) nameBox.innerText = 'Steve (Minecraft)';
            if (welcomeTitle) welcomeTitle.innerHTML = '<span>⛏️</span> Steve (Minecraft Edition):';
            if (welcomeMsg) welcomeMsg.innerText = 'Xin chào! Tôi là Steve trong thế giới Mario x Minecraft! Hãy nhấp vào màn hình để điều khiển tôi vung Kiếm Kim Cương 🗡️, vượt qua Cổng Nether và hạ gục Creeper 💥! Bạn có thể vừa chơi vừa chat cùng tôi nhé! ⭐';
        } else {
            if (skinIcon) skinIcon.innerText = '🍄';
            if (skinText) skinText.innerText = 'Chế độ: Mario Cổ Điển';
            if (fsSkinIcon) fsSkinIcon.innerText = '🍄';
            if (fsSkinText) fsSkinText.innerText = 'Đổi Skin: Minecraft';
            if (fsSkinBtn) {
                fsSkinBtn.style.background = '#991b1b';
                fsSkinBtn.style.borderColor = '#f87171';
                fsSkinBtn.style.color = '#fecaca';
            }
            if (btnSkin) {
                btnSkin.style.background = '#fef2f2';
                btnSkin.style.borderColor = '#f87171';
                btnSkin.style.color = '#dc2626';
            }
            if (avatarBox) {
                avatarBox.innerText = '🍄';
                avatarBox.style.background = '#fee2e2';
                avatarBox.style.borderColor = '#f87171';
            }
            if (nameBox) nameBox.innerText = 'Super Mario';
            if (welcomeTitle) welcomeTitle.innerHTML = '<span>🍄</span> Super Mario:';
            if (welcomeMsg) welcomeMsg.innerText = 'Yahoo! Chào mừng bạn đến với Vương quốc Nấm! Hãy nhấp vào màn hình bên trái để điều khiển tôi vượt chướng ngại vật nhé. Bạn có thể vừa chơi vừa nhắn tin hoặc hỏi đáp cùng tôi bất cứ lúc nào! ⭐';
        }
    }

    if (btnSkin && game) {
        updateSkinUI(game.skin);
        btnSkin.addEventListener('click', function() {
            var nextSkin = game.toggleSkin();
            updateSkinUI(nextSkin);
            var heroName = nextSkin === 'minecraft' ? 'Steve Minecraft' : 'Super Mario';
            window.marioChatBridge('skin', '🎨 Đã đổi giao diện game sang: <b>' + heroName + '</b>! Chúc bạn chơi game thật vui vẻ!');
            var canvas = document.getElementById('mario-canvas');
            if (canvas) canvas.focus();
        });
    }

    // 3. Nút Bật/Tắt Âm Thanh
    var btnSound = document.getElementById('btn-toggle-sound');
    var soundIcon = document.getElementById('sound-icon');
    var soundText = document.getElementById('sound-text');
    var fsSoundBtn = document.getElementById('fs-sound-btn');
    var soundMuted = false;

    if (btnSound) {
        btnSound.addEventListener('click', function() {
            soundMuted = !soundMuted;
            if (window.MarioAudio) {
                window.MarioAudio.muted = soundMuted;
            }
            if (fsSoundBtn) {
                fsSoundBtn.innerHTML = soundMuted ? '🔇' : '🔊';
            }
            if (soundMuted) {
                soundIcon.innerText = '🔇';
                soundText.innerText = 'Âm thanh: Tắt';
                btnSound.style.background = '#f1f5f9';
                btnSound.style.borderColor = '#cbd5e1';
                btnSound.style.color = '#64748b';
            } else {
                soundIcon.innerText = '🔊';
                soundText.innerText = 'Âm thanh: Bật';
                btnSound.style.background = '#fdf2f8';
                btnSound.style.borderColor = '#f472b6';
                btnSound.style.color = '#db2777';
            }
        });
    }

    // 4. Nút Chơi Lại
    var btnRestart = document.getElementById('btn-restart-game');
    if (btnRestart && game) {
        btnRestart.addEventListener('click', function() {
            game.restart();
            var canvas = document.getElementById('mario-canvas');
            if (canvas) canvas.focus();
        });
    }

    // 5. Bàn phím ảo trên giao diện
    function setupVirtualKey(id, keyName, keyCode) {
        var el = document.getElementById(id);
        if (!el || !game) return;
        var triggerDown = function(e) {
            e.preventDefault();
            game.keys[keyName] = true;
            game.keys[keyCode] = true;
            if (window.MarioAudio) window.MarioAudio.init();
            if (game.gameState === 'READY') game.gameState = 'PLAYING';
        };
        var triggerUp = function(e) {
            e.preventDefault();
            game.keys[keyName] = false;
            game.keys[keyCode] = false;
        };

        el.addEventListener('mousedown', triggerDown);
        el.addEventListener('mouseup', triggerUp);
        el.addEventListener('mouseleave', triggerUp);
        el.addEventListener('touchstart', triggerDown, { passive: false });
        el.addEventListener('touchend', triggerUp, { passive: false });
    }

    setupVirtualKey('vkey-left', 'ArrowLeft', 'ArrowLeft');
    setupVirtualKey('vkey-right', 'ArrowRight', 'ArrowRight');
    setupVirtualKey('vkey-jump', ' ', 'Space');

    // 6. Cầu nối Game sang Khung Chat (Event Reaction)
    window.marioChatBridge = function(type, message) {
        var msgBox = document.getElementById('mario-message-box');
        if (!msgBox) return;

        var colorBorder = '#fbcfe8';
        var badgeBg = '#fdf2f8';
        var icon = '🍄';

        if (type === 'skin') {
            colorBorder = '#86efac';
            badgeBg = '#f0fdf4';
            icon = '🎨';
        } else if (type === 'stomp') {
            colorBorder = '#86efac';
            badgeBg = '#f0fdf4';
            icon = (game && game.skin === 'minecraft') ? '💥' : '👞';
        } else if (type === 'coin') {
            colorBorder = '#38bdf8';
            badgeBg = '#f0f9ff';
            icon = (game && game.skin === 'minecraft') ? '💎' : '🪙';
        } else if (type === 'die' || type === 'gameover') {
            colorBorder = '#fca5a5';
            badgeBg = '#fef2f2';
            icon = '💔';
        } else if (type === 'win') {
            colorBorder = '#4ade80';
            badgeBg = '#dcfce7';
            icon = '🎉';
        } else if (type === 'start' || type === 'restart') {
            colorBorder = '#93c5fd';
            badgeBg = '#eff6ff';
            icon = (game && game.skin === 'minecraft') ? '⛏️' : '🍄';
        }

        var senderName = (game && game.skin === 'minecraft') ? 'Steve Minecraft' : 'Super Mario';
        var headerColor = (game && game.skin === 'minecraft') ? '#0284c7' : '#db2777';

        var liveMsgHtml = `
            <div class="message bot live-event" style="background: ${badgeBg}; border: 1px solid ${colorBorder}; border-radius: 12px; padding: 10px 12px; font-size: 13px; color: #1e293b; line-height: 1.4; animation: fadeIn 0.2s ease;">
                <b style="color: ${headerColor}; display: flex; align-items: center; gap: 4px; margin-bottom: 2px;">
                    <span>${icon}</span> ${senderName}:
                </b>
                ${message}
            </div>
        `;
        msgBox.insertAdjacentHTML('beforeend', liveMsgHtml);
        msgBox.scrollTop = msgBox.scrollHeight;
    };
}

if (document.readyState === 'loading') {
    document.addEventListener("DOMContentLoaded", initMarioApp);
} else {
    initMarioApp();
}

// Xử lý gửi tin nhắn Chat cho Mario / Steve
function handleSendChat(event) {
    if (event) event.preventDefault();
    var input = document.getElementById('mario-chat-input');
    if (!input) return;
    var text = input.value.trim();
    if (!text) return;

    input.value = '';
    sendChatMessageToMario(text);
}

function sendQuickMessage(text) {
    sendChatMessageToMario(text);
}

function sendChatMessageToMario(text) {
    var msgBox = document.getElementById('mario-message-box');
    if (!msgBox) return;

    // 1. Chèn tin nhắn của Người dùng
    var displayName = document.getElementById('nav-username-display') ? document.getElementById('nav-username-display').innerText.trim() : '<%= (typeof currentUser !== "undefined" && currentUser) ? currentUser : "Bạn" %>';
    var userHtml = `
        <div class="message user" style="align-self: flex-end; background: #db2777; color: #ffffff; border-radius: 14px 14px 4px 14px; padding: 10px 14px; font-size: 14px; max-width: 85%; box-shadow: 0 2px 8px rgba(219, 39, 119, 0.2);">
            <b>${displayName}:</b> ${text}
        </div>
    `;
    msgBox.insertAdjacentHTML('beforeend', userHtml);
    msgBox.scrollTop = msgBox.scrollHeight;

    // 2. Chèn trạng thái Đang gõ
    var isMinecraft = (window.MarioGame && window.marioInstance && window.marioInstance.skin === 'minecraft') || (localStorage.getItem('chatflex_mario_skin') === 'minecraft');
    var botIcon = isMinecraft ? '⛏️' : '🍄';
    var botName = isMinecraft ? 'Steve' : 'Mario';

    var typingId = 'typing-' + Date.now();
    var typingHtml = `
        <div id="${typingId}" class="message bot" style="background: #ffffff; border: 1px solid #fbcfe8; border-radius: 14px 14px 14px 4px; padding: 8px 12px; font-size: 13px; color: #94a3b8; max-width: 80%;">
            ${botIcon} ${botName} đang suy nghĩ...
        </div>
    `;
    msgBox.insertAdjacentHTML('beforeend', typingHtml);
    msgBox.scrollTop = msgBox.scrollHeight;

    // 3. Gửi tới Server
    fetch('/mario/message', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ message: text })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
        var typingElem = document.getElementById(typingId);
        if (typingElem) typingElem.remove();

        var botReply = (data && data.reply) ? data.reply : 'Yahoo! Đang tập trung chơi game nè!';
        var headerColor = isMinecraft ? '#0284c7' : '#db2777';
        var botHtml = `
            <div class="message bot" style="background: #ffffff; border: 1px solid #fbcfe8; border-radius: 14px 14px 14px 4px; padding: 12px 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); font-size: 14px; color: #1e293b; line-height: 1.5; max-width: 90%;">
                <b style="color: ${headerColor}; display: flex; align-items: center; gap: 5px; margin-bottom: 4px;">
                    <span>${botIcon}</span> ${botName}:
                </b>
                ${botReply}
            </div>
        `;
        msgBox.insertAdjacentHTML('beforeend', botHtml);
        msgBox.scrollTop = msgBox.scrollHeight;
    })
    .catch(function(err) {
        var typingElem = document.getElementById(typingId);
        if (typingElem) typingElem.remove();
        console.error('Lỗi gửi chat Mario:', err);
    });
}
</script>

<%- include('../partials/footer') %>
