<%- include('../partials/header') %>

<!-- Script Game Flappy Bird (Flappy Cat) để hỗ trợ khi bật chế độ chơi song song -->
<script src="/javascripts/flappy.js"></script>

<div class="chat-outer-wrapper">

    <!-- THANH CHỌN NHÂN VẬT (CHỈ HIỂN THỊ KHI ADMIN ĐĂNG NHẬP ĐỂ TEST NHÂN VẬT) -->
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <div class="char-switcher-bar">
            <span class="char-switcher-label">⚙️ Admin test:</span>
            <% if (typeof allCharacters !== 'undefined' && allCharacters && allCharacters.length > 0) { %>
                <% allCharacters.forEach(function(charItem) { %>
                    <% var isCurrent = character && character._id.toString() === charItem._id.toString(); %>
                    <a href="/chat/<%= charItem._id %>" class="char-switcher-link <%= isCurrent ? 'active' : '' %>">
                        <span class="char-switcher-icon"><%= charItem.icon || '🍄' %></span>
                        <span><%= charItem.name %></span>
                    </a>
                <% }); %>
            <% } %>
        </div>
    <% } %>

    <!-- VÙNG CHỨA BỐ CỤC CHAT (Có thể mở rộng khi bật Mario Game) -->
    <div id="chat-layout-wrapper" class="chat-layout-wrapper">
        
        <!-- BẢNG GAME FLAPPY BIRD SONG SONG (Mặc định ẩn, bật lên khi bấm nút) -->
        <div id="mario-side-panel" class="mario-side-panel">
            <!-- Header bar của panel -->
            <div class="mario-panel-header">
                <div class="mario-panel-title-group">
                    <span>🚀</span>
                    <span class="mario-panel-game-title">Flappy Bird (Flappy Cat)</span>
                    <span class="mario-fps-badge">⚡ 120 FPS</span>
                </div>
                <div class="mario-panel-actions">
                    <button type="button" id="side-audio-btn" onclick="toggleSideAudio()" title="Bật/Tắt âm thanh game" class="side-audio-btn">
                        🔊
                    </button>
                    <button type="button" onclick="restartSideMario()" title="Chơi lại từ đầu" class="side-restart-btn">
                        🔄
                    </button>
                    <button type="button" id="side-fs-btn" class="btn-mario-fullscreen-toggle side-fs-btn" onclick="toggleFullscreenMario('mario-side-panel')" title="Phóng to toàn màn hình để chơi">
                        <span class="fs-icon">⛶</span> <span class="fs-text">Toàn màn hình</span>
                    </button>
                </div>
            </div>

            <!-- Màn hình chơi Game Flappy Bangboo (DOM / GPU Hardware Accelerated - Không sử dụng Canvas) -->
            <div id="mario-side-canvas" class="mario-panel-canvas game-dom-viewport" tabindex="0"></div>

            <!-- Footer điều khiển & phím ảo cho Side Panel -->
            <div class="mario-panel-footer">
                <span>Điều khiển: <b>Chạm màn hình</b> hoặc phím <b>Space / W / ↑</b></span>
                <div class="mario-side-vkeys" style="display: flex; gap: 8px; width: 100%;">
                    <button type="button" class="side-vkey-jump" style="flex: 1;" onmousedown="if(window.marioSideGameInstance) window.marioSideGameInstance.flap();" ontouchstart="if(window.marioSideGameInstance) window.marioSideGameInstance.flap(); event.preventDefault();">🚀 BAY LÊN (Space / Chạm)</button>
                    <button type="button" class="side-vkey-btn" onclick="restartSideMario()" title="Chơi lại">🔄</button>
                </div>
            </div>
        </div>

        <!-- KHUNG CHAT CHÍNH -->
        <div id="chat-main-card" class="chat-card">
            
            <!-- Header Phòng Chat -->
            <div class="chat-header-bar">
                <div class="chat-header-info">
                    <% if (character && character.avatarUrl && !character.avatarUrl.includes('NaN')) { %>
                        <img src="<%= character.avatarUrl %>" class="chat-avatar-img" alt="<%= character.name %>" onerror="this.style.display='none'">
                    <% } else { %>
                        <div class="chat-avatar-placeholder">
                            <%= character && character.icon ? character.icon : '🤖' %>
                        </div>
                    <% } %>
                    <div>
                        <div class="chat-title-group">
                            <h2 class="chat-character-title"><%= character ? character.name : 'Phòng Chat' %></h2>
                            <% if (character && character.audioUrl) { %>
                                <button type="button" onclick="togglePlayVoice(this, '<%= character.audioUrl %>')" title="Nghe giọng chào của nhân vật" class="chat-voice-btn">
                                    🎵 Giọng nói
                                </button>
                            <% } %>
                        </div>
                        <span class="chat-online-badge">● Trực tuyến</span>
                    </div>
                </div>

                <!-- Các công cụ nhanh trên header -->
                <div class="chat-header-tools">
                    <!-- Nút reset cuộc trò chuyện -->
                    <button type="button" onclick="restartCurrentChat()" title="Làm mới cuộc trò chuyện" class="chat-tool-btn">
                        🔄 Làm mới
                    </button>

                    <!-- Nút bật/tắt âm thanh -->
                    <button type="button" id="btn-toggle-chat-sound" onclick="window.chatAudio.muted = !window.chatAudio.muted; this.innerText = window.chatAudio.muted ? '🔇' : '🔊';" title="Bật/Tắt âm thanh thông báo" class="chat-tool-btn">
                        🔊
                    </button>

                    <!-- Nút bật màn hình Flappy Bird song song -->
                    <button type="button" id="btn-toggle-mario-side" onclick="toggleMarioSidePanel()" class="chat-toggle-mario-btn">
                        🚀 Bật Flappy Bird
                    </button>
                </div>
            </div>

            <!-- Vùng cuộn tin nhắn hội thoại -->
            <div id="message-box" class="message-box">
                
                <% if (typeof initialBotMessage !== 'undefined' && initialBotMessage) { %>
                    <% var botMsgText = initialBotMessage.answerId ? initialBotMessage.answerId.answerText : "Xin chào! Rất vui được gặp bạn!"; %>
                    <div class="message bot">  
                        <div class="message-author-bot">
                            <b>
                                <span><%= character && character.icon ? character.icon : '🤖' %></span>
                                <%= character ? character.name : 'Bot' %>:
                            </b>
                        </div>
                        
                        <div><%= botMsgText %></div>
                        
                        <% if (initialBotMessage.imageId) { %>
                            <div class="media-box">
                                <img src="<%= initialBotMessage.imageId.imageUrl %>" class="chat-media-img" alt="Hình ảnh">
                            </div>
                        <% } %>
                        
                        <% var initialAudio = (initialBotMessage.audioId && initialBotMessage.audioId.audioUrl) ? initialBotMessage.audioId.audioUrl : (character && character.audioUrl ? character.audioUrl : null); %>
                        <% if (initialAudio) { %>
                            <div class="voice-bubble">
                                <button type="button" class="btn-play-voice" onclick="togglePlayVoice(this, '<%= initialAudio %>')">
                                    ▶
                                </button>
                                <div class="voice-wave-wrapper">
                                    <div class="voice-bubble-title">
                                        🎵 Tin nhắn thoại (<%= character ? character.name : 'Bot' %>)
                                    </div>
                                    <div class="voice-wave-container">
                                        <span class="voice-bar voice-bar-1"></span>
                                        <span class="voice-bar active voice-bar-2"></span>
                                        <span class="voice-bar voice-bar-3"></span>
                                        <span class="voice-bar active voice-bar-4"></span>
                                        <span class="voice-bar voice-bar-5"></span>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <!-- Lưu trữ thông tin nhân vật ẩn -->
            <input type="hidden" id="character-id" value="<%= character ? character._id : '' %>">
            <input type="hidden" id="character-icon" value="<%= character && character.icon ? character.icon : '🤖' %>">
            <input type="hidden" id="character-name" value="<%= character ? character.name : 'Bot' %>">

            <!-- CÁC NÚT CÂU HỎI LỰA CHỌN THEO KỊCH BẢN (THIẾT KẾ PASTEL PILL SANG TRỌNG) -->
            <div id="options-container" class="options-in-chat">
                <div class="options-title">
                    <span class="options-title-badge">💡 Gợi ý câu hỏi</span>
                    <span class="options-title-sub">Chạm để hỏi nhanh</span>
                </div>
                <% if (typeof questions !== 'undefined' && questions && questions.length > 0) { %>
                    <% questions.forEach(function(q) { %>
                        <button type="button" class="question-btn" onclick="sendQuestion('<%= q._id %>', '<%= q.questionText.replace(/'/g, "\\'") %>')">
                            <span class="q-icon-pill"><%= character && character.icon ? character.icon : '🩺' %></span>
                            <span class="q-text"><%= q.questionText %></span>
                            <span class="q-arrow">➔</span>
                        </button>
                    <% }); %>
                <% } else { %>
                    <div class="chat-finished-box">
                        <p class="chat-finished-text">🎉 Đã hoàn thành kịch bản hội thoại này!</p>
                        <button type="button" onclick="restartCurrentChat()" class="btn-chat-restart">
                            🔄 Bắt đầu lại cuộc trò chuyện
                        </button>
                    </div>
                <% } %>
            </div>

            <!-- Ô NHẬP TIN NHẮN TỰ DO (FREE-TEXT CHAT INPUT) -->
            <div class="chat-input-bar">
                <form id="chat-free-form" class="chat-free-form" onsubmit="handleSendFreeText(event)">
                    <input type="text" id="chat-free-input" class="chat-free-input" placeholder="Nhập câu hỏi để trò chuyện cùng <%= character ? character.name : 'Bot' %>..." autocomplete="off">
                    <button type="submit" class="chat-send-btn">
                        Gửi 🚀
                    </button>
                </form>
            </div>

        </div>
    </div>

</div>

<%- include('../partials/footer') %>
