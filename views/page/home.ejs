<%- include('../partials/header') %>

<div class="container" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 65vh; text-align: center; padding: 20px 15px;">
    <h1 style="margin-bottom: 12px; color: #1e293b; font-size: 32px; font-weight: 800; text-shadow: 2px 2px 0px #fbcfe8;">
        Chào mừng bạn đến với Phổi bạn không phải tôi
    </h1>
    <p style="color: #64748b; margin-bottom: 25px; font-size: 16px; max-width: 550px;">
        Nền tảng trò chuyện thông minh kết hợp giải trí game retro Super Mario độc đáo!
    </p>

    <!-- Nút chơi Mario & Chat nhanh -->
    <div style="margin-bottom: 28px;">
        <a href="/mario" class="btn" style="background: #f59e0b; color: #fff; padding: 12px 28px; font-size: 16px; font-weight: 700; text-decoration: none; border-radius: 12px; border: 2px solid #b45309; box-shadow: 3px 3px 0px #78350f; display: inline-flex; align-items: center; gap: 8px; transition: transform 0.15s ease;">
            <span style="font-size: 20px;">🎮</span> Chơi Super Mario & Chat (120 FPS)
        </a>
    </div>

    <!-- DANH SÁCH CÁC NHÂN VẬT ĐỂ BẮT ĐẦU TRÒ CHUYỆN -->
    <div style="width: 100%; max-width: 780px; text-align: left; background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(10px); border-radius: 20px; border: 2px solid #fbcfe8; padding: 22px; box-shadow: 0 4px 16px rgba(244, 114, 182, 0.12);">
        <h2 style="font-size: 16px; font-weight: 800; color: #db2777; margin: 0 0 14px 0; display: flex; align-items: center; gap: 6px;">
            <span>👥</span> Chọn nhân vật để bắt đầu cuộc trò chuyện:
        </h2>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px;">
            <% if (typeof allCharacters !== 'undefined' && allCharacters && allCharacters.length > 0) { %>
                <% allCharacters.forEach(function(c) { %>
                    <a href="/chat/<%= c._id %>" style="display: flex; flex-direction: column; text-decoration: none; background: #ffffff; border: 1.5px solid #fbcfe8; border-radius: 14px; padding: 14px; transition: all 0.15s ease; box-shadow: 0 2px 6px rgba(0,0,0,0.03);"
                        onmouseover="this.style.borderColor='#db2777'; this.style.transform='translateY(-2px)';"
                        onmouseout="this.style.borderColor='#fbcfe8'; this.style.transform='translateY(0)';"
                    >
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                            <span style="font-size: 28px; line-height: 1;"><%= c.icon || '🍄' %></span>
                            <div>
                                <div style="font-size: 14px; font-weight: 700; color: #1e293b;"><%= c.name %></div>
                                <% if (c.isDefault) { %>
                                    <span style="font-size: 10px; background: #dcfce7; color: #166534; font-weight: 700; padding: 1px 6px; border-radius: 6px;">Mặc định</span>
                                <% } %>
                            </div>
                        </div>
                        <p style="font-size: 12px; color: #64748b; margin: 0 0 10px 0; line-height: 1.4; flex: 1;">
                            <%= c.description || 'Nhân vật kịch bản tương tác đa tầng.' %>
                        </p>
                        <span style="font-size: 12px; font-weight: 700; color: #db2777; display: flex; align-items: center; gap: 4px;">
                            Trò chuyện ngay ➜
                        </span>
                    </a>
                <% }); %>
            <% } else { %>
                <p style="color: #64748b; font-size: 13px; margin: 0;">Chưa có nhân vật nào. Hãy vào <a href="/admin" style="color: #db2777; font-weight: bold;">Trang Quản trị</a> để thêm nhân vật!</p>
            <% } %>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
