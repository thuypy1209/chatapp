<%- include('../partials/header') %>

<div class="container home-container">
    <h1 class="home-title">
        Chào mừng bạn đến với Phổi bạn không phải tôi
    </h1>
    <p class="home-subtitle">
        Nền tảng trò chuyện thông minh kết hợp giải trí game retro Super Mario độc đáo!
    </p>

    <!-- Chỉ hiển thị 2 nút: Trò chuyện & Chơi -->
    <div class="home-actions">
        <!-- Nút Trò chuyện với nhân vật mặc định do Admin chọn -->
        <% if (defaultCharacter) { %>
            <a href="/chat/<%= defaultCharacter._id %>" class="btn btn-home-chat">
                <span class="btn-home-icon"><%= defaultCharacter.icon || '💬' %></span> Trò chuyện với <%= defaultCharacter.name %>
            </a>
        <% } else { %>
            <a href="/chat" class="btn btn-home-chat">
                <span class="btn-home-icon">💬</span> Vào phòng Chat
            </a>
        <% } %>

        <!-- Nút Chơi Flappy Bird  -->
        <a href="/flappy" class="btn btn-home-mario">
            <span class="btn-home-icon">🚀</span> Chơi Flappy Bangboo
        </a>
    </div>
</div>

<%- include('../partials/footer') %>
